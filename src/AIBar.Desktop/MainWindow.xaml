<Window x:Class="AIBar.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AIBar.Desktop"
        xmlns:automation="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        Title="AIBar quota" Width="420" MinWidth="300" MinHeight="260" MaxHeight="720" SizeToContent="Height"
        FontFamily="{DynamicResource AppFont}" FontSize="14"
        Tag="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <local:ProviderVisuals x:Key="PanelPalette" />
        <local:PanelGlowConverter x:Key="PanelGlow" />
        <local:PanelTextVisibilityConverter x:Key="PanelTextVisibility" />
        <local:PanelHalfWidthConverter x:Key="PanelHalfWidth" />
