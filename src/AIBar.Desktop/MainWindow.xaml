        <FontFamily x:Key="PanelDisplayFont">Bahnschrift SemiCondensed, Bahnschrift, Segoe UI Variable Display, Segoe UI</FontFamily>
        <Style x:Key="PanelProviderMark" TargetType="{x:Type Path}">
            <Setter Property="Width" Value="22" /><Setter Property="Height" Value="22" />
            <Setter Property="Stretch" Value="Uniform" /><Setter Property="Margin" Value="0,0,10,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Tag" Value="{DynamicResource SurfaceBrush}" />
        </Style>
        <Style x:Key="PanelProviderTitle" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="{StaticResource PanelDisplayFont}" />
            <Setter Property="FontSize" Value="19" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PanelPill" TargetType="{x:Type Border}">
            <Setter Property="Tag" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="10" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="7,2,9,2" /><Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="BorderBrush"><Setter.Value><MultiBinding Converter="{StaticResource PanelPalette}" ConverterParameter="Border">
                <Binding Source="0" /><Binding Path="Tag" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag.Color" RelativeSource="{RelativeSource Self}" />
            </MultiBinding></Setter.Value></Setter>
            <Setter Property="Background"><Setter.Value><MultiBinding Converter="{StaticResource PanelPalette}" ConverterParameter="Pill">
                <Binding Source="0" /><Binding Path="Tag" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag.Color" RelativeSource="{RelativeSource Self}" />
            </MultiBinding></Setter.Value></Setter>
        </Style>
        <Style x:Key="PanelPillText" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="11.5" /><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" /><Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PanelGlyph" TargetType="{x:Type TextBlock}">
            <Setter Property="FontFamily" Value="Segoe MDL2 Assets" /><Setter Property="FontSize" Value="11" />
            <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="0,0,5,0" />
        </Style>
        <Style x:Key="PanelRule" TargetType="{x:Type Border}">
            <Setter Property="Tag" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderThickness" Value="0,1,0,0" />
            <Setter Property="BorderBrush"><Setter.Value><MultiBinding Converter="{StaticResource PanelPalette}" ConverterParameter="Line">
                <Binding Source="0" /><Binding Path="Tag" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag.Color" RelativeSource="{RelativeSource Self}" />
            </MultiBinding></Setter.Value></Setter>
        </Style>
        <!-- Amber notice card for warnings; collapses when there is nothing to say. -->
        <Style x:Key="PanelNotice" TargetType="{x:Type Border}">
            <Setter Property="Tag" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="CornerRadius" Value="12" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,9" /><Setter Property="Margin" Value="0,0,0,12" />
            <Setter Property="BorderBrush"><Setter.Value><MultiBinding Converter="{StaticResource PanelPalette}" ConverterParameter="Notice">
                <Binding Source="0" /><Binding Path="Tag" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag.Color" RelativeSource="{RelativeSource Self}" />
            </MultiBinding></Setter.Value></Setter>
            <Setter Property="Background"><Setter.Value><MultiBinding Converter="{StaticResource PanelPalette}" ConverterParameter="NoticeFill">
                <Binding Source="0" /><Binding Path="Tag" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag.Color" RelativeSource="{RelativeSource Self}" />
            </MultiBinding></Setter.Value></Setter>
        </Style>
        <Style x:Key="QuotaStatusTextStyle" TargetType="{x:Type TextBlock}" BasedOn="{StaticResource QuotaStatusTextStyle}">
            <Style.Triggers>
                <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PanelQuotaCardStyle" TargetType="{x:Type Border}" BasedOn="{StaticResource QuotaCardStyle}">
            <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBorderBrush}" />
            <Setter Property="CornerRadius" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="PanelActionButtonStyle" TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="ContentTemplate">
                <Setter.Value><DataTemplate><StackPanel Orientation="Horizontal">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="{Binding Tag, RelativeSource={RelativeSource AncestorType=Button}}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding}" VerticalAlignment="Center" />
                </StackPanel></DataTemplate></Setter.Value>
            </Setter>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Button}">
                        <Border x:Name="ActionChrome" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" RecognizesAccessKey="True" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBorderBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PanelDetailsExpanderStyle" TargetType="{x:Type Expander}" BasedOn="{StaticResource AccessibleExpanderStyle}">
            <EventSetter Event="PreviewKeyDown" Handler="OnPanelDisclosureKeyDown" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type Expander}">
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <ToggleButton x:Name="HeaderSite" Focusable="False" IsTabStop="False"
                                          Foreground="{TemplateBinding Foreground}" Background="Transparent"
                                          HorizontalContentAlignment="Stretch" Padding="0,10,24,10"
                                          Content="{TemplateBinding Header}" ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="{x:Type ToggleButton}">
                                        <Border Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" CornerRadius="6">
                                            <ContentPresenter RecognizesAccessKey="True" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <Path x:Name="DetailsChevron" Data="M 0,0 L 4,4 L 8,0" Stroke="{TemplateBinding Foreground}"
                                  StrokeThickness="1.5" Width="8" Height="4" HorizontalAlignment="Right"
                                  VerticalAlignment="Center" Margin="0,0,4,0" IsHitTestVisible="False" />
                            <ContentPresenter x:Name="DetailsBody" Grid.Row="1" ContentSource="Content"
                                              HorizontalAlignment="Stretch" Visibility="Collapsed" />
                        </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded" Value="True">
                                <Setter TargetName="DetailsBody" Property="Visibility" Value="Visible" />
                                <Setter TargetName="DetailsChevron" Property="Data" Value="M 0,4 L 4,0 L 8,4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Slim overlay-style scroll bar for the details area: rounded thumb, no arrow buttons. -->
        <Style x:Key="PanelScrollBarStyle" TargetType="{x:Type ScrollBar}">
            <Setter Property="Width" Value="6" /><Setter Property="MinWidth" Value="6" />
            <Setter Property="Margin" Value="4,2,0,2" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ScrollBar}">
                        <Grid Background="{TemplateBinding Background}">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="{x:Type RepeatButton}"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" IsTabStop="False">
                                        <RepeatButton.Template><ControlTemplate TargetType="{x:Type RepeatButton}"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb>
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="{x:Type Thumb}">
                                                <Border x:Name="ThumbChrome" CornerRadius="3" Background="{DynamicResource MutedTextBrush}" Opacity="0.45" />
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ThumbChrome" Property="Opacity" Value="0.75" /></Trigger>
                                                    <Trigger Property="IsDragging" Value="True"><Setter TargetName="ThumbChrome" Property="Opacity" Value="0.9" /></Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="Orientation" Value="Horizontal">
                    <Setter Property="Width" Value="Auto" /><Setter Property="MinWidth" Value="0" />
                    <Setter Property="Height" Value="6" /><Setter Property="Margin" Value="2,4,2,0" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <!-- Graphite surface; translucent only while the acrylic backdrop is active. -->
    <Window.Background>
        <MultiBinding Converter="{StaticResource PanelPalette}" ConverterParameter="Surface">
            <Binding Path="IsTranslucent" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag.Color" RelativeSource="{RelativeSource Self}" />
        </MultiBinding>
    </Window.Background>
    <Window.Template>
        <ControlTemplate TargetType="{x:Type Window}">
            <!-- 8px matches the rounded DWM corners so acrylic never shows past the border. -->
            <Border x:Name="PanelSurface" Background="{TemplateBinding Background}" CornerRadius="8" BorderThickness="1" Tag="{DynamicResource SurfaceBrush}">
                <Border.BorderBrush><MultiBinding Converter="{StaticResource PanelPalette}" ConverterParameter="Border">
                    <Binding Source="0" /><Binding Path="Tag" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag.Color" RelativeSource="{RelativeSource Self}" />
                </MultiBinding></Border.BorderBrush>
                <AdornerDecorator><ContentPresenter /></AdornerDecorator>
            </Border>
        </ControlTemplate>
    </Window.Template>
    <Grid Margin="0" KeyboardNavigation.TabNavigation="Continue">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header band: diamond eyebrow and freshness. -->
        <Grid x:Name="PanelHeaderBand" Grid.Row="0" Height="40" Tag="{DynamicResource SurfaceBrush}" automation:AutomationProperties.Name="Quota summary">
            <Grid.Background><MultiBinding Converter="{StaticResource PanelPalette}" ConverterParameter="Band">
                <Binding Source="0" /><Binding Path="Tag" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag.Color" RelativeSource="{RelativeSource Self}" />
            </MultiBinding></Grid.Background>
            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Margin="20,0,0,0" VerticalAlignment="Center">
                <Rectangle Width="7" Height="7" RadiusX="1" RadiusY="1" Margin="0,0,9,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5" Tag="{DynamicResource SurfaceBrush}">
                    <Rectangle.RenderTransform><RotateTransform Angle="45" /></Rectangle.RenderTransform>
                    <Rectangle.Fill><MultiBinding Converter="{StaticResource PanelPalette}" ConverterParameter="Brand">
                        <Binding Source="0" /><Binding Path="Tag" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag.Color" RelativeSource="{RelativeSource Self}" />
                    </MultiBinding></Rectangle.Fill>
                </Rectangle>
                <TextBlock Text="AIBAR" FontFamily="{StaticResource PanelDisplayFont}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" automation:AutomationProperties.Name="AIBar" />
            </StackPanel>
            <TextBlock Grid.Column="1" Margin="8,0,20,0" VerticalAlignment="Center" FontSize="12" Text="{Binding FreshnessLabel}" Style="{StaticResource QuotaStatusTextStyle}" automation:AutomationProperties.LiveSetting="Polite" />
            <Border Grid.ColumnSpan="2" Style="{StaticResource PanelRule}" BorderThickness="0,0,0,1" />
        </Grid>

        <StackPanel Grid.Row="1" Margin="20,16,20,4" automation:AutomationProperties.Name="Quota cards">
            <Grid Margin="0,0,0,2">
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                <Path Data="{StaticResource OpenAiMark}" Style="{StaticResource PanelProviderMark}">
                    <Path.Fill><MultiBinding Converter="{StaticResource PanelPalette}" ConverterParameter="Codex"><Binding Source="0" /><Binding Path="Tag" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag.Color" RelativeSource="{RelativeSource Self}" /></MultiBinding></Path.Fill>
                    <Path.Effect><MultiBinding Converter="{StaticResource PanelGlow}" ConverterParameter="#10A37F"><Binding Source="0" /><Binding Path="Tag" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag.Color" RelativeSource="{RelativeSource Self}" /></MultiBinding></Path.Effect>
                </Path>
                <TextBlock Grid.Column="1" Text="CODEX" Style="{StaticResource PanelProviderTitle}" automation:AutomationProperties.Name="Codex" />
                <Border Grid.Column="2" Style="{StaticResource PanelPill}">
                    <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE977;" Style="{StaticResource PanelGlyph}" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock Text="This PC" Style="{StaticResource PanelPillText}" /></StackPanel>
                </Border>
            </Grid>
            <TextBlock Text="{Binding State.UpdatedLabel}" Style="{StaticResource QuotaStatusTextStyle}" FontSize="12" Margin="32,0,0,12" />
            <TextBlock Text="{Binding State.CachedAgeLabel}" Style="{StaticResource QuotaStatusTextStyle}" automation:AutomationProperties.LiveSetting="Polite" />
            <Border Style="{StaticResource PanelNotice}" Visibility="{Binding State.WarningLabel, Converter={StaticResource PanelTextVisibility}, FallbackValue=Collapsed}">
                <TextBlock Text="{Binding State.WarningLabel}" TextWrapping="Wrap" FontSize="12" Style="{StaticResource QuotaStatusTextStyle}" Foreground="{DynamicResource TextBrush}" automation:AutomationProperties.LiveSetting="Polite" />
            </Border>
            <TextBlock Text="Loading quota" Visibility="{Binding State.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource QuotaStatusTextStyle}" />
            <TextBlock Text="Credential unavailable" Visibility="{Binding State.IsMissingCredential, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource QuotaStatusTextStyle}" />
            <TextBlock Text="Offline cached quota" Visibility="{Binding State.IsOffline, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource QuotaStatusTextStyle}" />
            <TextBlock Text="Cached quota is degraded" Visibility="{Binding State.IsDegraded, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource QuotaStatusTextStyle}" />
            <TextBlock Text="Quota unavailable" Visibility="{Binding State.IsUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource QuotaStatusTextStyle}" />
            <TextBlock Text="Private quota integration is disabled" Visibility="{Binding State.IsPrivateIntegrationDisabled, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource QuotaStatusTextStyle}" />
            <TextBlock Text="Quota error" Visibility="{Binding State.IsSafeError, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource QuotaStatusTextStyle}" />
            <GroupBox automation:AutomationProperties.Name="Weekly quota card" automation:AutomationProperties.HelpText="Weekly quota percentage, reset, and state" automation:AutomationProperties.ItemStatus="{Binding FreshnessLabel}" Visibility="{Binding State.IsWeeklyAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource ChromeLessGroupBoxStyle}">
                <Border Style="{StaticResource PanelQuotaCardStyle}">
                    <local:PanelMeter Label="{Binding Weekly.Label}" Usage="{Binding Weekly.PercentageUsed}" IsCurrent="{Binding State.IsCurrent, FallbackValue=True}" ResetCountdown="{Binding Weekly.ResetCountdown}" MeterName="Weekly quota progress" />
                </Border>
            </GroupBox>
            <GroupBox automation:AutomationProperties.Name="5-hour quota card" automation:AutomationProperties.HelpText="5-hour quota percentage, reset, and state" automation:AutomationProperties.ItemStatus="{Binding FreshnessLabel}" Visibility="{Binding State.IsPrimaryAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource ChromeLessGroupBoxStyle}">
                <Border Style="{StaticResource PanelQuotaCardStyle}">
                    <local:PanelMeter Label="{Binding Primary.Label}" Usage="{Binding Primary.PercentageUsed}" IsCurrent="{Binding State.IsCurrent, FallbackValue=True}" ResetCountdown="{Binding Primary.ResetCountdown}" MeterName="5-hour quota progress" />
                </Border>
            </GroupBox>

            <StackPanel x:Name="ClaudeQuotaSection"
                        Visibility="{Binding Claude.IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                <Border Style="{StaticResource PanelRule}" Margin="0,4,0,16" />
                <Grid Margin="0,0,0,2">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <Path Data="{StaticResource ClaudeMark}" Style="{StaticResource PanelProviderMark}">
                        <Path.Fill><MultiBinding Converter="{StaticResource PanelPalette}" ConverterParameter="Claude"><Binding Source="0" /><Binding Path="Tag" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag.Color" RelativeSource="{RelativeSource Self}" /></MultiBinding></Path.Fill>
                        <Path.Effect><MultiBinding Converter="{StaticResource PanelGlow}" ConverterParameter="#D97757"><Binding Source="0" /><Binding Path="Tag" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag.Color" RelativeSource="{RelativeSource Self}" /></MultiBinding></Path.Effect>
                    </Path>
                    <TextBlock Grid.Column="1" Text="CLAUDE" Style="{StaticResource PanelProviderTitle}" automation:AutomationProperties.Name="Claude" />
                    <Border Grid.Column="2" Style="{StaticResource PanelPill}" Visibility="{Binding Claude.State.SourceLabel, Converter={StaticResource PanelTextVisibility}, FallbackValue=Collapsed}">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE7F8;" Style="{StaticResource PanelGlyph}" Foreground="{DynamicResource MutedTextBrush}" /><TextBlock Text="{Binding Claude.State.SourceLabel}" Style="{StaticResource PanelPillText}" /></StackPanel>
                    </Border>
                </Grid>
                <TextBlock Text="{Binding Claude.State.UpdatedLabel}" Style="{StaticResource QuotaStatusTextStyle}" FontSize="12" Margin="32,0,0,12" />
                <!-- Only a non-current state needs words here; current data already says when it was updated. -->
                <TextBlock Text="{Binding Claude.State.FreshnessLabel}" automation:AutomationProperties.LiveSetting="Polite" Margin="0,0,0,4">
                    <TextBlock.Style><Style TargetType="{x:Type TextBlock}" BasedOn="{StaticResource QuotaStatusTextStyle}">
                        <Style.Triggers><DataTrigger Binding="{Binding Claude.State.IsCurrent}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers>
                    </Style></TextBlock.Style>
                </TextBlock>
                <TextBlock Text="{Binding Claude.State.CachedAgeLabel}" Style="{StaticResource QuotaStatusTextStyle}" automation:AutomationProperties.LiveSetting="Polite" />
                <Border Style="{StaticResource PanelNotice}" Visibility="{Binding Claude.State.WarningLabel, Converter={StaticResource PanelTextVisibility}, FallbackValue=Collapsed}">
                    <TextBlock Text="{Binding Claude.State.WarningLabel}" TextWrapping="Wrap" FontSize="12" Style="{StaticResource QuotaStatusTextStyle}" Foreground="{DynamicResource TextBrush}" automation:AutomationProperties.LiveSetting="Polite" />
                </Border>
                <GroupBox automation:AutomationProperties.Name="Claude weekly quota card" automation:AutomationProperties.HelpText="Claude weekly quota percentage, reset, and state" automation:AutomationProperties.ItemStatus="{Binding Claude.State.FreshnessLabel}"
                          Visibility="{Binding Claude.State.IsWeeklyAvailable, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" Style="{StaticResource ChromeLessGroupBoxStyle}">
                    <Border Style="{StaticResource PanelQuotaCardStyle}">
                        <local:PanelMeter Label="{Binding Claude.State.Weekly.Label}" Usage="{Binding Claude.State.Weekly.PercentageUsed}" IsCurrent="{Binding Claude.State.IsCurrent, FallbackValue=True}" ResetCountdown="{Binding Claude.State.Weekly.ResetCountdown}" MeterName="Claude weekly quota progress" />
                    </Border>
                </GroupBox>
                <GroupBox automation:AutomationProperties.Name="Claude 5-hour quota card" automation:AutomationProperties.HelpText="Claude 5-hour quota percentage, reset, and state" automation:AutomationProperties.ItemStatus="{Binding Claude.State.FreshnessLabel}"
                          Visibility="{Binding Claude.State.IsPrimaryAvailable, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" Style="{StaticResource ChromeLessGroupBoxStyle}">
                    <Border Style="{StaticResource PanelQuotaCardStyle}">
                        <local:PanelMeter Label="{Binding Claude.State.Primary.Label}" Usage="{Binding Claude.State.Primary.PercentageUsed}" IsCurrent="{Binding Claude.State.IsCurrent, FallbackValue=True}" ResetCountdown="{Binding Claude.State.Primary.ResetCountdown}" MeterName="Claude 5-hour quota progress" />
                    </Border>
                </GroupBox>
            </StackPanel>
        </StackPanel>

        <ScrollViewer x:Name="SecondaryScrollViewer" Grid.Row="2" Margin="20,0,20,0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewGotKeyboardFocus="OnSecondaryPreviewGotKeyboardFocus" automation:AutomationProperties.Name="Secondary analytics">
            <ScrollViewer.Resources>
                <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource PanelScrollBarStyle}" />
            </ScrollViewer.Resources>
            <Expander x:Name="AnalyticsDetailsExpander" IsExpanded="False" Focusable="True" IsTabStop="True"
                      Style="{StaticResource PanelDetailsExpanderStyle}" BorderThickness="0,1,0,0" BorderBrush="{DynamicResource SecondaryBorderBrush}"
                      automation:AutomationProperties.Name="Local analytics details" automation:AutomationProperties.HelpText="Quota pace, local usage breakdown and quota access information">
                <Expander.Header><TextBlock Text="Pace &amp; details" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" /></Expander.Header>
                <StackPanel Margin="0,8,0,0">
                    <TextBlock Text="PACE" FontFamily="{StaticResource PanelDisplayFont}" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,12" />
                    <local:PanelPaceRow Data="{Binding State.Weekly.Pace}" />
                    <local:PanelPaceRow Data="{Binding State.Primary.Pace}" />
                    <StackPanel Visibility="{Binding Claude.IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <local:PanelPaceRow Data="{Binding Claude.State.Weekly.Pace}" />
                        <local:PanelPaceRow Data="{Binding Claude.State.Primary.Pace}" />
                    </StackPanel>
                    <Border Style="{StaticResource PanelNotice}" Visibility="{Binding State.Weekly.Pace.Notice, Converter={StaticResource PanelTextVisibility}, FallbackValue=Collapsed}">
                        <TextBlock Text="{Binding State.Weekly.Pace.Notice}" TextWrapping="Wrap" FontSize="12" automation:AutomationProperties.LiveSetting="Polite" />
                    </Border>
                    <Border Style="{StaticResource PanelNotice}" Visibility="{Binding State.Primary.Pace.Notice, Converter={StaticResource PanelTextVisibility}, FallbackValue=Collapsed}">
                        <TextBlock Text="{Binding State.Primary.Pace.Notice}" TextWrapping="Wrap" FontSize="12" automation:AutomationProperties.LiveSetting="Polite" />
                    </Border>
                    <StackPanel Visibility="{Binding Claude.IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <Border Style="{StaticResource PanelNotice}" Visibility="{Binding Claude.State.Weekly.Pace.Notice, Converter={StaticResource PanelTextVisibility}, FallbackValue=Collapsed}">
                            <TextBlock Text="{Binding Claude.State.Weekly.Pace.Notice}" TextWrapping="Wrap" FontSize="12" automation:AutomationProperties.LiveSetting="Polite" />
                        </Border>
                        <Border Style="{StaticResource PanelNotice}" Visibility="{Binding Claude.State.Primary.Pace.Notice, Converter={StaticResource PanelTextVisibility}, FallbackValue=Collapsed}">
                            <TextBlock Text="{Binding Claude.State.Primary.Pace.Notice}" TextWrapping="Wrap" FontSize="12" automation:AutomationProperties.LiveSetting="Polite" />
                        </Border>
                    </StackPanel>
                    <StackPanel Margin="0,8,0,8" TextElement.FontSize="12">
                        <TextBlock Text="CODEX · ESTIMATED COST" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Text="{Binding Analytics.UsageCost.TodayLabel}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Analytics.UsageCost.Last30DaysLabel}" TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Margin="0,0,0,8" TextElement.FontSize="12" Visibility="{Binding Claude.IsEnabled, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}">
                        <TextBlock Text="CLAUDE · ESTIMATED COST" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" />
                        <TextBlock Text="{Binding ClaudeCost.State.TodayLabel}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ClaudeCost.State.Last30DaysLabel}" TextWrapping="Wrap" />
                    </StackPanel>
                    <TextBlock Text="Local usage" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,8,0,8" />
                    <StackPanel TextElement.FontSize="12">
                    <GroupBox Header="Local Codex data" automation:AutomationProperties.Name="Local Codex data" Style="{StaticResource SecondaryGroupBoxStyle}"><Border Style="{StaticResource SecondaryCardStyle}"><StackPanel Margin="16">
                        <TextBlock Text="{Binding Analytics.SourceDetail}" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding Analytics.TotalTokensLabel}" FontWeight="SemiBold" Margin="0,8,0,0" /><TextBlock Text="{Binding Analytics.ModelTotalsLabel}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Analytics.CoverageLabel}" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="{Binding Analytics.LastScanLabel}" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding Analytics.WarningLabel}" Style="{StaticResource MutedTextStyle}" /><TextBlock Text="Loading local Codex data" Visibility="{Binding Analytics.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource MutedTextStyle}" />
                    </StackPanel></Border></GroupBox>

                    <GroupBox Header="OpenCode and Pi local usage" automation:AutomationProperties.Name="OpenCode and Pi local usage" Style="{StaticResource SecondaryGroupBoxStyle}" Margin="0,8,0,0"><Border Style="{StaticResource SecondaryCardStyle}"><StackPanel Margin="16">
                        <TextBlock Text="{Binding LocalUsage.Description}" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" />
                        <TextBlock Text="{Binding LocalUsage.StatusLabel}" FontWeight="SemiBold" Margin="0,8,0,0" />
                        <ItemsControl ItemsSource="{Binding LocalUsage.Rows}" Focusable="False" Foreground="{DynamicResource TextBrush}" Margin="0,4,0,0"><ItemsControl.ItemTemplate><DataTemplate>
                            <Expander IsExpanded="False" Focusable="True" IsTabStop="True" Style="{StaticResource PanelDetailsExpanderStyle}" HorizontalContentAlignment="Stretch" Margin="0,4,0,0" automation:AutomationProperties.Name="{Binding AutomationLabel}">
                                <Expander.Header><Grid TextElement.Foreground="{DynamicResource TextBrush}"><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                    <TextBlock Text="{Binding ScopeLabel}" FontWeight="SemiBold" />
                                    <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding TotalLabel}" TextWrapping="Wrap" />
                                    <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding StatusLabel}" Style="{StaticResource MutedTextStyle}" />
                                </Grid></Expander.Header>
                                <StackPanel>
                                    <TextBlock Text="{Binding TokenBreakdownLabel}" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" Margin="0,0,0,8" />
                                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,4,0,0">
                                    <ItemsControl ItemsSource="{Binding Details}" Focusable="False" Foreground="{DynamicResource TextBrush}"><ItemsControl.ItemTemplate><DataTemplate>
                                        <Grid Margin="16,4,0,4" TextElement.Foreground="{DynamicResource TextBrush}"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                            <TextBlock Text="{Binding LocalDayLabel}" FontWeight="SemiBold" automation:AutomationProperties.Name="{Binding AutomationLabel}" />
                                            <TextBlock Grid.Column="1" Text="{Binding ModelLabel}" TextWrapping="Wrap" Margin="8,0,0,0" />
                                            <TextBlock Grid.Row="1" Grid.ColumnSpan="2" Text="{Binding TotalLabel}" />
                                            <TextBlock Grid.Row="2" Grid.ColumnSpan="2" Text="{Binding TokenBreakdownLabel}" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" />
                                        </Grid>
                                    </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                                </ScrollViewer>
                                </StackPanel>
                            </Expander>
                        </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                    </StackPanel></Border></GroupBox>
                    <TextBlock Text="Quota access" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,16,0,8" />
                    <TextBlock Text="{Binding State.Disclosure}" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" />
                    <TextBlock Text="{Binding PrivateEndpointDisclosure}" TextWrapping="Wrap" Style="{StaticResource MutedTextStyle}" Margin="0,4,0,12" />
                    </StackPanel>
                </StackPanel>
            </Expander>
        </ScrollViewer>

        <!-- Ghost actions on the darker band. -->
        <StackPanel Grid.Row="3" Tag="{DynamicResource SurfaceBrush}" Margin="0,8,0,0" automation:AutomationProperties.Name="Quota footer">
            <StackPanel.Background><MultiBinding Converter="{StaticResource PanelPalette}" ConverterParameter="Band">
                <Binding Source="0" /><Binding Path="Tag" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag.Color" RelativeSource="{RelativeSource Self}" />
            </MultiBinding></StackPanel.Background>
            <Border x:Name="PanelFooterRule" Style="{StaticResource PanelRule}" />
            <WrapPanel x:Name="PanelActions" Orientation="Horizontal" Margin="12,6,12,6"
                       ItemWidth="{Binding ActualWidth, RelativeSource={RelativeSource Self}, Converter={StaticResource PanelHalfWidth}}">
                <Button Tag="&#xE8C8;" Content="Copy summary" Command="{Binding CopySummaryCommand}" Style="{StaticResource PanelActionButtonStyle}" automation:AutomationProperties.Name="Copy quota summary" IsTabStop="True" Margin="0" />
                <Button Tag="&#xE72C;" Content="Refresh" Command="{Binding RefreshCommand}" Style="{StaticResource PanelActionButtonStyle}" HorizontalContentAlignment="Right" Visibility="{Binding IsRefreshAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" automation:AutomationProperties.Name="Refresh quota" IsTabStop="True" Margin="0" />
            </WrapPanel>
            <TextBlock Text="{Binding CopySummaryCommand.Feedback}" Style="{StaticResource QuotaStatusTextStyle}" Margin="20,0,20,8" automation:AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Grid>
</Window>
