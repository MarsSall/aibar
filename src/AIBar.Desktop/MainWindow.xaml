<Window x:Class="AIBar.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AIBar.Desktop"
        xmlns:automation="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        Title="AIBar quota" Width="360" MinWidth="300" MinHeight="260" MaxHeight="720" SizeToContent="Height"
        FontFamily="{DynamicResource AppFont}" FontSize="14"
        Tag="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display">
    <Window.Resources>
        <local:PanelProviderSelectionConverter x:Key="ProviderSelection" />
        <local:ProviderVisuals x:Key="PanelPalette" />
        <local:PanelTextVisibilityConverter x:Key="PanelTextVisibility" />
        <local:PanelUpdatedConverter x:Key="PanelUpdated" />
        <local:PanelCostLabelConverter x:Key="PanelCostLabel" />
