        <Style x:Key="PanelMiniUsageStyle" TargetType="ProgressBar" BasedOn="{StaticResource QuotaProgressStyle}">
            <Setter Property="Height" Value="2" /><Setter Property="Background" Value="{DynamicResource ProgressTrackBrush}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="2"><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="2" HorizontalAlignment="Left" /></Border></ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="ProviderTabStyle" TargetType="RadioButton">
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" />
            <Setter Property="Background" Value="{DynamicResource CardBrush}" />
            <Setter Property="Height" Value="48" />
            <Setter Property="Padding" Value="14,8" /><Setter Property="MinWidth" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Margin" Value="3,0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}"><ContentPresenter /></Border>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource CardBrush}" /></Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background"><Setter.Value><MultiBinding Converter="{StaticResource TabDecoration}" ConverterParameter="Fill"><Binding Path="Tag" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=local:MainWindow}" /><Binding Path="CodexUsage" RelativeSource="{RelativeSource AncestorType=local:MainWindow}" /><Binding Path="ClaudeUsage" RelativeSource="{RelativeSource AncestorType=local:MainWindow}" /><Binding Path="State.IsCurrent" /><Binding Path="Claude.State.IsCurrent" /><Binding Path="ProviderTint" RelativeSource="{RelativeSource AncestorType=local:MainWindow}" /></MultiBinding></Setter.Value></Setter>
                    <Setter Property="BorderBrush"><Setter.Value><MultiBinding Converter="{StaticResource TabDecoration}" ConverterParameter="Border"><Binding Path="Tag" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=local:MainWindow}" /><Binding Path="CodexUsage" RelativeSource="{RelativeSource AncestorType=local:MainWindow}" /><Binding Path="ClaudeUsage" RelativeSource="{RelativeSource AncestorType=local:MainWindow}" /><Binding Path="State.IsCurrent" /><Binding Path="Claude.State.IsCurrent" /><Binding Path="ProviderTint" RelativeSource="{RelativeSource AncestorType=local:MainWindow}" /></MultiBinding></Setter.Value></Setter>
                    <Setter Property="Foreground"><Setter.Value><MultiBinding Converter="{StaticResource TabDecoration}" ConverterParameter="Text"><Binding Path="Tag" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=local:MainWindow}" /></MultiBinding></Setter.Value></Setter><Setter Property="FontWeight" Value="SemiBold" />
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource FocusBrush}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PanelProviderMark" TargetType="Path">
            <Setter Property="Width" Value="18" /><Setter Property="Height" Value="18" />
            <Setter Property="Stretch" Value="Uniform" /><Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="PanelLiveDot" TargetType="Ellipse">
            <Setter Property="Width" Value="6" /><Setter Property="Height" Value="6" /><Setter Property="HorizontalAlignment" Value="Left" /><Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Fill" Value="{DynamicResource SuccessTextBrush}" /><Setter Property="Stroke" Value="{DynamicResource SuccessTextBrush}" /><Setter Property="StrokeThickness" Value="1" />
            <Style.Triggers><DataTrigger Binding="{Binding IsCurrent}" Value="False"><Setter Property="Fill" Value="Transparent" /><Setter Property="Stroke" Value="{DynamicResource TertiaryTextBrush}" /></DataTrigger></Style.Triggers>
        </Style>
        <Style x:Key="PanelLiveRing" TargetType="Ellipse" BasedOn="{StaticResource PanelLiveDot}"><Setter Property="Width" Value="12" /><Setter Property="Height" Value="12" /><Setter Property="Margin" Value="-3,0,0,0" /><Setter Property="Opacity" Value="0.18" /><Setter Property="StrokeThickness" Value="0" /></Style>
        <Style x:Key="PanelProviderTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="16" /><Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="QuotaStatusTextStyle" TargetType="TextBlock" BasedOn="{StaticResource QuotaStatusTextStyle}">
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <Trigger Property="Text" Value="{x:Null}"><Setter Property="Visibility" Value="Collapsed" /></Trigger>
                <Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PanelRule" TargetType="Border">
            <!-- One DIP remains visible at 100% scale with layout rounding enabled. -->
            <Setter Property="BorderThickness" Value="0,1,0,0" /><Setter Property="BorderBrush" Value="{DynamicResource SecondaryBorderBrush}" />
        </Style>
        <Style x:Key="PanelHeaderRule" TargetType="Border" BasedOn="{StaticResource PanelRule}">
            <Setter Property="BorderBrush"><Setter.Value><MultiBinding Converter="{StaticResource WindowDecoration}" ConverterParameter="Divider">
                <Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=local:MainWindow}" /><Binding Path="SelectedProvider" RelativeSource="{RelativeSource AncestorType=local:MainWindow}" /><Binding Path="CodexUsage" RelativeSource="{RelativeSource AncestorType=local:MainWindow}" /><Binding Path="ClaudeUsage" RelativeSource="{RelativeSource AncestorType=local:MainWindow}" /><Binding Path="State.IsCurrent" /><Binding Path="Claude.State.IsCurrent" /><Binding Path="State.NeedsLogin" /><Binding Path="Claude.State.NeedsLogin" /><Binding Path="ProviderTint" RelativeSource="{RelativeSource AncestorType=local:MainWindow}" />
            </MultiBinding></Setter.Value></Setter>
        </Style>
        <Style x:Key="PanelQuotaCardStyle" TargetType="Border" BasedOn="{StaticResource QuotaCardStyle}">
            <Setter Property="CornerRadius" Value="0" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource SecondaryBorderBrush}" />
        </Style>
        <Style x:Key="PanelActionButtonStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
            <Setter Property="BorderBrush" Value="Transparent" /><Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="10,4" /><Setter Property="MinHeight" Value="30" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="FontSize" Value="14" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ActionChrome" CornerRadius="4" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Padding="{TemplateBinding Padding}">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="26" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="{TemplateBinding Tag}" VerticalAlignment="Center" />
                        <ContentPresenter Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
                        <TextBlock Grid.Column="2" Text="{TemplateBinding local:PanelMenuHints.Shortcut}" Foreground="{DynamicResource TertiaryTextBrush}" FontSize="12" VerticalAlignment="Center" Margin="10,0,0,0" />
                    </Grid>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource PanelMenuHighlightBrush}" /><Setter Property="Foreground" Value="{DynamicResource PanelMenuHighlightTextBrush}" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource PressedBrush}" /><Setter Property="Foreground" Value="{DynamicResource PanelMenuHighlightTextBrush}" /></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PanelLinkStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}" /><Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="2" /><Setter Property="FontSize" Value="13" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource KeyboardFocusVisual}" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="FlatChrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                    <ContentPresenter Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource PanelRowHoverBrush}" /></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="{DynamicResource PanelRowHoverBrush}" /></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PanelIncidentStyle" TargetType="Button" BasedOn="{StaticResource PanelLinkStyle}">
            <Setter Property="Margin" Value="0,12,0,4" /><Setter Property="Padding" Value="10,8" /><Setter Property="Tag" Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="Background" Value="{DynamicResource WarningBackgroundBrush}" /><Setter Property="BorderBrush" Value="{DynamicResource WarningTextBrush}" /><Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground"><Setter.Value><MultiBinding Converter="{StaticResource PanelPalette}" ConverterParameter="Notice">
                <Binding Source="0" /><Binding Path="Tag" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag.Color" RelativeSource="{RelativeSource Self}" />
            </MultiBinding></Setter.Value></Setter>
            <Setter Property="ContentTemplate"><Setter.Value><DataTemplate>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="24" /><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <TextBlock Text="⚠" FontSize="14" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding}" TextWrapping="Wrap" FontSize="12" FontWeight="SemiBold" />
                    <TextBlock Grid.Column="2" Text="View status" FontSize="12" Foreground="{DynamicResource LinkBrush}" TextDecorations="Underline" Margin="8,0,0,0" VerticalAlignment="Center" />
                </Grid>
            </DataTemplate></Setter.Value></Setter>
        </Style>
        <DataTemplate x:Key="PanelStateBanners">
            <StackPanel>
                <Border Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource WarningTextBrush}" BorderThickness="1" CornerRadius="4" Padding="14" Margin="0,12,0,4" Visibility="{Binding NeedsLogin, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" automation:AutomationProperties.LiveSetting="Polite">
                    <StackPanel>
                        <local:PanelSectionLabel Text="⚿  SIGN-IN NEEDED" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarningTextBrush}" />
                        <TextBlock Text="{Binding WarningLabel}" TextWrapping="Wrap" FontSize="13" Margin="0,6,0,10" />
                        <WrapPanel>
                            <Button Content="Try again" Command="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}" MinHeight="32" Margin="0,0,8,0" automation:AutomationProperties.Name="Try sign-in again" />
                            <Button Content="Use other machine" Click="OnUseOtherMachine" MinHeight="32" automation:AutomationProperties.Name="Use other machine for quota data">
                                <Button.Style><Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding SelectedProvider, RelativeSource={RelativeSource AncestorType=local:MainWindow}}" Value="Claude"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style></Button.Style>
                            </Button>
                        </WrapPanel>
                    </StackPanel>
                </Border>
                <Border Background="{DynamicResource WarningBackgroundBrush}" BorderBrush="{DynamicResource WarningTextBrush}" BorderThickness="1" CornerRadius="4" Padding="10" Margin="0,12,0,4" Visibility="{Binding ShowStaleBanner, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" automation:AutomationProperties.LiveSetting="Polite">
                    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <StackPanel><local:PanelSectionLabel Text="NOT CURRENT" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource WarningTextBrush}" /><TextBlock Text="{Binding LastReadingLabel}" FontSize="12" TextWrapping="Wrap" Margin="0,4,8,0" /></StackPanel>
                        <Button Grid.Column="1" Content="Refresh" Command="{Binding DataContext.RefreshCommand, RelativeSource={RelativeSource AncestorType=Window}}" MinHeight="28" VerticalAlignment="Center" automation:AutomationProperties.Name="Refresh not current quota" />
                    </Grid>
                </Border>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="PanelDetailsExpanderStyle" TargetType="Expander" BasedOn="{StaticResource AccessibleExpanderStyle}">
            <EventSetter Event="PreviewKeyDown" Handler="OnPanelDisclosureKeyDown" />
        </Style>
        <Style x:Key="PanelScrollBarStyle" TargetType="ScrollBar">
            <Setter Property="Width" Value="6" /><Setter Property="MinWidth" Value="6" /><Setter Property="Margin" Value="4,2,0,2" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
                <Track x:Name="PART_Track" IsDirectionReversed="True">
                    <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" IsTabStop="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                    <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" IsTabStop="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                    <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Background="{DynamicResource MutedTextBrush}" Opacity="0.6" /></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
                </Track>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <Window.Background><MultiBinding Converter="{StaticResource PanelPalette}" ConverterParameter="Surface">
        <Binding Path="IsTranslucent" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag" RelativeSource="{RelativeSource Self}" /><Binding Path="Tag.Color" RelativeSource="{RelativeSource Self}" /><Binding Path="BackgroundOpacity" RelativeSource="{RelativeSource Self}" />
    </MultiBinding></Window.Background>
    <Window.Template><ControlTemplate TargetType="Window">
        <Border x:Name="PanelSurface" Background="{TemplateBinding Background}" CornerRadius="8" BorderThickness="1" Tag="{DynamicResource SurfaceBrush}">
            <Border.BorderBrush><MultiBinding Converter="{StaticResource WindowDecoration}"><Binding Path="Tag" RelativeSource="{RelativeSource TemplatedParent}" /><Binding Path="SelectedProvider" RelativeSource="{RelativeSource TemplatedParent}" /><Binding Path="CodexUsage" RelativeSource="{RelativeSource TemplatedParent}" /><Binding Path="ClaudeUsage" RelativeSource="{RelativeSource TemplatedParent}" /><Binding Path="DataContext.State.IsCurrent" RelativeSource="{RelativeSource TemplatedParent}" /><Binding Path="DataContext.Claude.State.IsCurrent" RelativeSource="{RelativeSource TemplatedParent}" /><Binding Path="DataContext.State.NeedsLogin" RelativeSource="{RelativeSource TemplatedParent}" /><Binding Path="DataContext.Claude.State.NeedsLogin" RelativeSource="{RelativeSource TemplatedParent}" /><Binding Path="ProviderTint" RelativeSource="{RelativeSource TemplatedParent}" /></MultiBinding></Border.BorderBrush>
            <Border.Effect><MultiBinding Converter="{StaticResource WindowDecoration}" ConverterParameter="Glow"><Binding Path="Tag" RelativeSource="{RelativeSource TemplatedParent}" /><Binding Path="SelectedProvider" RelativeSource="{RelativeSource TemplatedParent}" /><Binding Path="CodexUsage" RelativeSource="{RelativeSource TemplatedParent}" /><Binding Path="ClaudeUsage" RelativeSource="{RelativeSource TemplatedParent}" /><Binding Path="DataContext.State.IsCurrent" RelativeSource="{RelativeSource TemplatedParent}" /><Binding Path="DataContext.Claude.State.IsCurrent" RelativeSource="{RelativeSource TemplatedParent}" /><Binding Path="DataContext.State.NeedsLogin" RelativeSource="{RelativeSource TemplatedParent}" /><Binding Path="DataContext.Claude.State.NeedsLogin" RelativeSource="{RelativeSource TemplatedParent}" /><Binding Path="ProviderTint" RelativeSource="{RelativeSource TemplatedParent}" /></MultiBinding></Border.Effect>
            <AdornerDecorator><ContentPresenter /></AdornerDecorator>
        </Border>
    </ControlTemplate></Window.Template>
    <Grid KeyboardNavigation.TabNavigation="Continue" Margin="16,6,16,6">
        <Grid.RowDefinitions><RowDefinition Height="*" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <ScrollViewer x:Name="SecondaryScrollViewer" Grid.Row="0" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" PreviewGotKeyboardFocus="OnSecondaryPreviewGotKeyboardFocus" automation:AutomationProperties.Name="Quota and analytics">
            <ScrollViewer.Resources><Style TargetType="ScrollBar" BasedOn="{StaticResource PanelScrollBarStyle}" /></ScrollViewer.Resources>
            <Grid>
                <StackPanel x:Name="SummaryView" automation:AutomationProperties.Name="Quota summary">
                    <UniformGrid Rows="1" Margin="-3,0,-3,6" automation:AutomationProperties.Name="Providers">
                        <RadioButton x:Name="CodexTab" Tag="Codex" GroupName="Providers" Style="{StaticResource ProviderTabStyle}" Click="OnProviderTab" PreviewKeyDown="OnProviderTabKeyDown" IsChecked="{Binding SelectedProvider, RelativeSource={RelativeSource AncestorType=local:MainWindow}, Converter={StaticResource ProviderSelection}, ConverterParameter=Codex, Mode=OneWay}" automation:AutomationProperties.Name="Codex provider tab">
                            <StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Path Data="{StaticResource OpenAiMark}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource CodexUiBrush}" />
                                <TextBlock Text="Codex" Margin="6,0,0,0" /></StackPanel>
                                <TextBlock Text="●" FontSize="8" HorizontalAlignment="Center" Visibility="{Binding ProviderStatus.CodexDescription, RelativeSource={RelativeSource AncestorType=local:MainWindow}, Converter={StaticResource PanelTextVisibility}, FallbackValue=Collapsed}" automation:AutomationProperties.Name="OpenAI service incident" />
                                <ProgressBar x:Name="CodexTabUsage" Style="{StaticResource PanelMiniUsageStyle}" Height="2" Margin="0,6,0,0" Maximum="100" Value="{Binding CodexUsage, RelativeSource={RelativeSource AncestorType=local:MainWindow}}" automation:AutomationProperties.Name="Codex tab usage">
                                    <ProgressBar.Foreground><MultiBinding Converter="{StaticResource PanelPalette}" ConverterParameter="Meter"><Binding Path="CodexUsage" RelativeSource="{RelativeSource AncestorType=local:MainWindow}" /><Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=local:MainWindow}" /><Binding Path="Tag.Color" RelativeSource="{RelativeSource AncestorType=local:MainWindow}" /><Binding Path="State.IsCurrent" /><Binding Source="Codex" /><Binding Path="BarColorMode" RelativeSource="{RelativeSource AncestorType=local:MainWindow}" /></MultiBinding></ProgressBar.Foreground>
                                </ProgressBar>
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="ClaudeTab" Tag="Claude" GroupName="Providers" Style="{StaticResource ProviderTabStyle}" Click="OnProviderTab" PreviewKeyDown="OnProviderTabKeyDown" Visibility="{Binding ClaudeEnabled, RelativeSource={RelativeSource AncestorType=local:MainWindow}, Converter={StaticResource BooleanToVisibilityConverter}}" IsChecked="{Binding SelectedProvider, RelativeSource={RelativeSource AncestorType=local:MainWindow}, Converter={StaticResource ProviderSelection}, ConverterParameter=Claude, Mode=OneWay}" automation:AutomationProperties.Name="Claude provider tab">
                            <StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><Path Data="{StaticResource ClaudeMark}" Width="16" Height="16" Stretch="Uniform" Fill="{DynamicResource ClaudeUiBrush}" />
                                <TextBlock Text="Claude" Margin="6,0,0,0" /></StackPanel>
                                <TextBlock Text="●" FontSize="8" HorizontalAlignment="Center" Visibility="{Binding ProviderStatus.ClaudeDescription, RelativeSource={RelativeSource AncestorType=local:MainWindow}, Converter={StaticResource PanelTextVisibility}, FallbackValue=Collapsed}" automation:AutomationProperties.Name="Anthropic service incident" />
                                <ProgressBar x:Name="ClaudeTabUsage" Style="{StaticResource PanelMiniUsageStyle}" Height="2" Margin="0,6,0,0" Maximum="100" Value="{Binding ClaudeUsage, RelativeSource={RelativeSource AncestorType=local:MainWindow}}" automation:AutomationProperties.Name="Claude tab usage">
                                    <ProgressBar.Foreground><MultiBinding Converter="{StaticResource PanelPalette}" ConverterParameter="Meter"><Binding Path="ClaudeUsage" RelativeSource="{RelativeSource AncestorType=local:MainWindow}" /><Binding Path="Tag" RelativeSource="{RelativeSource AncestorType=local:MainWindow}" /><Binding Path="Tag.Color" RelativeSource="{RelativeSource AncestorType=local:MainWindow}" /><Binding Path="Claude.State.IsCurrent" /><Binding Source="Claude" /><Binding Path="BarColorMode" RelativeSource="{RelativeSource AncestorType=local:MainWindow}" /></MultiBinding></ProgressBar.Foreground>
                                </ProgressBar>
                            </StackPanel>
                        </RadioButton>
                    </UniformGrid>
                    <Border x:Name="TabsRule" Style="{StaticResource PanelHeaderRule}" Margin="0,0,0,8" />
                    <StackPanel x:Name="QuotaCards" automation:AutomationProperties.Name="Quota cards" Margin="0,4,0,4">
                        <StackPanel x:Name="CodexQuotaSection" Visibility="{Binding SelectedProvider, RelativeSource={RelativeSource AncestorType=local:MainWindow}, Converter={StaticResource ProviderSelection}, ConverterParameter=Codex}">
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                            <TextBlock Grid.ColumnSpan="2" Text="Codex" Style="{StaticResource PanelProviderTitle}" automation:AutomationProperties.Name="Codex" />
                            <Ellipse Grid.Row="1" DataContext="{Binding State}" Style="{StaticResource PanelLiveRing}" />
                            <Ellipse Grid.Row="1" DataContext="{Binding State}" Style="{StaticResource PanelLiveDot}" />
                            <TextBlock Grid.Row="1" Text="{Binding State.UpdatedLabel, Converter={StaticResource PanelUpdated}}" Style="{StaticResource QuotaStatusTextStyle}" Margin="12,3,8,0" FontSize="12" />
                            <Border Grid.Column="1" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource CodexUiBrush}" Padding="8,2" HorizontalAlignment="Right" Visibility="{Binding State.PlanLabel, Converter={StaticResource PanelTextVisibility}, FallbackValue=Collapsed}"><TextBlock Text="{Binding State.PlanLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource CodexUiBrush}" automation:AutomationProperties.Name="Codex plan" /></Border>
                        </Grid>
                        <Button Content="{Binding ProviderStatus.CodexDescription, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PanelIncidentStyle}" Click="OnCodexStatus"
                                Visibility="{Binding ProviderStatus.CodexDescription, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PanelTextVisibility}, FallbackValue=Collapsed}"
                                automation:AutomationProperties.Name="Open OpenAI service status" automation:AutomationProperties.HelpText="{Binding ProviderStatus.CodexDescription, RelativeSource={RelativeSource AncestorType=Window}}" automation:AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="{Binding FreshnessLabel}" automation:AutomationProperties.LiveSetting="Polite">
                            <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource QuotaStatusTextStyle}"><Style.Triggers><DataTrigger Binding="{Binding State.IsCurrent}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                        </TextBlock>
                        <TextBlock Text="{Binding State.CachedAgeLabel}" Style="{StaticResource QuotaStatusTextStyle}" automation:AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="{Binding State.WarningLabel}" Style="{StaticResource QuotaStatusTextStyle}" automation:AutomationProperties.LiveSetting="Polite" />
                        <TextBlock Text="Loading quota" Visibility="{Binding State.IsLoading, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource QuotaStatusTextStyle}" />
                        <TextBlock Text="Credential unavailable" Visibility="{Binding State.IsMissingCredential, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource QuotaStatusTextStyle}" />
                        <TextBlock Text="Offline cached quota" Visibility="{Binding State.IsOffline, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource QuotaStatusTextStyle}" />
                        <TextBlock Text="Cached quota is degraded" Visibility="{Binding State.IsDegraded, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource QuotaStatusTextStyle}" />
                        <TextBlock Text="Quota unavailable" Visibility="{Binding State.IsUnavailable, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource QuotaStatusTextStyle}" />
                        <TextBlock Text="Private quota integration is disabled" Visibility="{Binding State.IsPrivateIntegrationDisabled, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource QuotaStatusTextStyle}" />
                        <TextBlock Text="Quota error" Visibility="{Binding State.IsSafeError, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource QuotaStatusTextStyle}" />
                        <ContentControl Content="{Binding State}" ContentTemplate="{StaticResource PanelStateBanners}" Focusable="False" IsTabStop="False" />
                        <Border x:Name="CodexHeaderRule" Style="{StaticResource PanelHeaderRule}" Margin="0,4,0,0" />
                        <!-- Availability, not authentication, controls cached meter visibility. -->
                        <GroupBox automation:AutomationProperties.Name="5-hour quota card" automation:AutomationProperties.HelpText="5-hour quota percentage, reset, and state" automation:AutomationProperties.ItemStatus="{Binding FreshnessLabel}" Visibility="{Binding State.IsPrimaryAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource ChromeLessGroupBoxStyle}">
                            <Border Style="{StaticResource PanelQuotaCardStyle}"><local:PanelMeter Label="{Binding Primary.Label}" Usage="{Binding Primary.PercentageUsed}" IsCurrent="{Binding State.IsCurrent, FallbackValue=True}" ResetCountdown="{Binding Primary.ResetCountdown}" MeterName="5-hour quota progress" /></Border>
                        </GroupBox>
                        <GroupBox automation:AutomationProperties.Name="Weekly quota card" automation:AutomationProperties.HelpText="Weekly quota percentage, reset, and state" automation:AutomationProperties.ItemStatus="{Binding FreshnessLabel}" Visibility="{Binding State.IsWeeklyAvailable, Converter={StaticResource BooleanToVisibilityConverter}}" Style="{StaticResource ChromeLessGroupBoxStyle}">
                            <Border Style="{StaticResource PanelQuotaCardStyle}"><local:PanelMeter Label="{Binding Weekly.Label}" Usage="{Binding Weekly.PercentageUsed}" IsCurrent="{Binding State.IsCurrent, FallbackValue=True}" ResetCountdown="{Binding Weekly.ResetCountdown}" Pace="{Binding State.Weekly.Pace}" MeterName="Weekly quota progress" /></Border>
                        </GroupBox>
                        </StackPanel>
                        <StackPanel x:Name="ClaudeQuotaSection" Visibility="{Binding SelectedProvider, RelativeSource={RelativeSource AncestorType=local:MainWindow}, Converter={StaticResource ProviderSelection}, ConverterParameter=Claude}">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                <TextBlock Grid.ColumnSpan="2" Text="Claude" Style="{StaticResource PanelProviderTitle}" automation:AutomationProperties.Name="Claude" />
                                <Ellipse Grid.Row="1" DataContext="{Binding Claude.State}" Style="{StaticResource PanelLiveRing}" />
                                <Ellipse Grid.Row="1" DataContext="{Binding Claude.State}" Style="{StaticResource PanelLiveDot}" />
                                <TextBlock Grid.Row="1" Style="{StaticResource QuotaStatusTextStyle}" Margin="12,3,8,0" FontSize="12"><TextBlock.Text><MultiBinding Converter="{StaticResource PanelUpdated}"><Binding Path="Claude.State.UpdatedLabel" /><Binding Path="Claude.State.SourceLabel" /></MultiBinding></TextBlock.Text></TextBlock>
                                <Border Grid.Column="1" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource ClaudeUiBrush}" Padding="8,2" HorizontalAlignment="Right" Visibility="{Binding Claude.PlanLabel, Converter={StaticResource PanelTextVisibility}, FallbackValue=Collapsed}"><TextBlock Text="{Binding Claude.PlanLabel}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource ClaudeUiBrush}" automation:AutomationProperties.Name="Claude plan" /></Border>
                            </Grid>
                            <Button Content="{Binding ProviderStatus.ClaudeDescription, RelativeSource={RelativeSource AncestorType=Window}}" Style="{StaticResource PanelIncidentStyle}" Click="OnClaudeStatus"
                                    Visibility="{Binding ProviderStatus.ClaudeDescription, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource PanelTextVisibility}, FallbackValue=Collapsed}"
                                    automation:AutomationProperties.Name="Open Anthropic service status" automation:AutomationProperties.HelpText="{Binding ProviderStatus.ClaudeDescription, RelativeSource={RelativeSource AncestorType=Window}}" automation:AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="{Binding Claude.State.FreshnessLabel}" automation:AutomationProperties.LiveSetting="Polite">
                                <TextBlock.Style><Style TargetType="TextBlock" BasedOn="{StaticResource QuotaStatusTextStyle}"><Style.Triggers><DataTrigger Binding="{Binding Claude.State.IsCurrent}" Value="True"><Setter Property="Visibility" Value="Collapsed" /></DataTrigger></Style.Triggers></Style></TextBlock.Style>
                            </TextBlock>
                            <TextBlock Text="{Binding Claude.State.CachedAgeLabel}" Style="{StaticResource QuotaStatusTextStyle}" automation:AutomationProperties.LiveSetting="Polite" />
                            <TextBlock Text="{Binding Claude.State.WarningLabel}" Style="{StaticResource QuotaStatusTextStyle}" automation:AutomationProperties.LiveSetting="Polite" />
                            <ContentControl Content="{Binding Claude.State}" ContentTemplate="{StaticResource PanelStateBanners}" Focusable="False" IsTabStop="False" />
                            <Border x:Name="ClaudeHeaderRule" Style="{StaticResource PanelHeaderRule}" Margin="0,4,0,0" />
                            <!-- Keep safe cached values visible next to the sign-in warning. -->
                            <GroupBox automation:AutomationProperties.Name="Claude 5-hour quota card" automation:AutomationProperties.HelpText="Claude 5-hour quota percentage, reset, and state" automation:AutomationProperties.ItemStatus="{Binding Claude.State.FreshnessLabel}" Visibility="{Binding Claude.State.IsPrimaryAvailable, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" Style="{StaticResource ChromeLessGroupBoxStyle}">
                                <Border Style="{StaticResource PanelQuotaCardStyle}"><local:PanelMeter Provider="Claude" Label="{Binding Claude.State.Primary.Label}" Usage="{Binding Claude.State.Primary.PercentageUsed}" IsCurrent="{Binding Claude.State.IsCurrent, FallbackValue=True}" ResetCountdown="{Binding Claude.State.Primary.ResetCountdown}" MeterName="Claude 5-hour quota progress" /></Border>
                            </GroupBox>
                            <GroupBox automation:AutomationProperties.Name="Claude weekly quota card" automation:AutomationProperties.HelpText="Claude weekly quota percentage, reset, and state" automation:AutomationProperties.ItemStatus="{Binding Claude.State.FreshnessLabel}" Visibility="{Binding Claude.State.IsWeeklyAvailable, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}" Style="{StaticResource ChromeLessGroupBoxStyle}">
                                <Border Style="{StaticResource PanelQuotaCardStyle}"><local:PanelMeter Provider="Claude" Label="{Binding Claude.State.Weekly.Label}" Usage="{Binding Claude.State.Weekly.PercentageUsed}" IsCurrent="{Binding Claude.State.IsCurrent, FallbackValue=True}" ResetCountdown="{Binding Claude.State.Weekly.ResetCountdown}" Pace="{Binding Claude.State.Weekly.Pace}" MeterName="Claude weekly quota progress" /></Border>
                            </GroupBox>
                        </StackPanel>
                    </StackPanel>
                    <Border x:Name="WindowsRule" Style="{StaticResource PanelRule}" Margin="0,2,0,6" />
                    <Button x:Name="CostButton" Click="OnCost" PreviewKeyDown="OnNavigationKeyDown" MouseEnter="OnCostMouseEnter" MouseLeave="OnCostMouseLeave" Style="{StaticResource PanelLinkStyle}" Foreground="{DynamicResource TextBrush}" Padding="0" Margin="-8,0,-8,10" automation:AutomationProperties.Name="Cost details">
                        <Border x:Name="CostCard" Background="{DynamicResource PanelCardBrush}" BorderBrush="{DynamicResource PanelCardBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8">
                            <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="24" /></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <local:PanelSectionLabel x:Name="CostTitle" Text="COST" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,6" />
                                    <!-- Explicit bounded columns: long/partial labels wrap without
                                         painting into their neighbour or the chevron. -->
                                    <Grid Visibility="{Binding SelectedProvider, RelativeSource={RelativeSource AncestorType=local:MainWindow}, Converter={StaticResource ProviderSelection}, ConverterParameter=Codex}">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding CodexCost.TodayLabel, Converter={StaticResource PanelCostLabel}, ConverterParameter=Amount}" /><TextBlock FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Text="{Binding CodexCost.TodayLabel, Converter={StaticResource PanelCostLabel}, ConverterParameter=Meta}" /></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding CodexCost.Last30DaysLabel, Converter={StaticResource PanelCostLabel}, ConverterParameter=Amount}" /><TextBlock FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Text="{Binding CodexCost.Last30DaysLabel, Converter={StaticResource PanelCostLabel}, ConverterParameter=Meta}" /></StackPanel>
                                    </Grid>
                                    <Grid Visibility="{Binding SelectedProvider, RelativeSource={RelativeSource AncestorType=local:MainWindow}, Converter={StaticResource ProviderSelection}, ConverterParameter=Claude}">
                                        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="12" /><ColumnDefinition /></Grid.ColumnDefinitions>
                                        <StackPanel><TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding ClaudeCost.State.TodayLabel, Converter={StaticResource PanelCostLabel}, ConverterParameter=Amount}" /><TextBlock FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Text="{Binding ClaudeCost.State.TodayLabel, Converter={StaticResource PanelCostLabel}, ConverterParameter=Meta}" /></StackPanel>
                                        <StackPanel Grid.Column="2"><TextBlock FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" Text="{Binding ClaudeCost.State.Last30DaysLabel, Converter={StaticResource PanelCostLabel}, ConverterParameter=Amount}" /><TextBlock FontSize="12" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Text="{Binding ClaudeCost.State.Last30DaysLabel, Converter={StaticResource PanelCostLabel}, ConverterParameter=Meta}" /></StackPanel>
                                    </Grid>
                                </StackPanel>
                                <TextBlock x:Name="CostChevron" Grid.Column="1" Text="›" HorizontalAlignment="Right" Foreground="{DynamicResource MutedTextBrush}" FontSize="20" FontWeight="Normal" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </Button>
                </StackPanel>
                <StackPanel x:Name="DetailView" Visibility="Collapsed">
                    <DockPanel Margin="0,0,0,6">
                        <Button x:Name="CloseDetailsButton" DockPanel.Dock="Right" Content="×" Click="OnCloseDetails" Style="{StaticResource PanelLinkStyle}" FontSize="13" automation:AutomationProperties.Name="Close usage details" />
                        <TextBlock Text="Usage details" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center" />
                    </DockPanel>
                    <local:QuotaHistoryChart History="{Binding PaceHistory, RelativeSource={RelativeSource AncestorType={x:Type local:MainWindow}}}" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
        <StackPanel Grid.Row="1" automation:AutomationProperties.Name="Quota footer">
            <Border x:Name="PanelFooterRule" Style="{StaticResource PanelRule}" />
            <StackPanel x:Name="PanelActions" Margin="-6,4,-6,0">
                <Button Tag="&#xE9D9;" Content="Usage Dashboard" Click="OnUsageDashboard" Style="{StaticResource PanelActionButtonStyle}" automation:AutomationProperties.Name="Usage Dashboard" />
                <Button Tag="&#xE95E;" Content="Status Page" Click="OnStatusPages" Style="{StaticResource PanelActionButtonStyle}" automation:AutomationProperties.Name="Status Page" />
                <Border Style="{StaticResource PanelRule}" Margin="6,5" />
                <Button Tag="&#xE72C;" Content="Refresh" ToolTip="Refresh (Ctrl+R)" local:PanelMenuHints.Shortcut="Ctrl+R" Command="{Binding RefreshCommand}" IsEnabled="{Binding IsRefreshAvailable, FallbackValue=False}" Style="{StaticResource PanelActionButtonStyle}" automation:AutomationProperties.Name="Refresh quota" IsTabStop="True" />
                <Button Tag="&#xE8C8;" Content="Copy summary" local:PanelMenuHints.Shortcut="Ctrl+C" Command="{Binding CopySummaryCommand}" Style="{StaticResource PanelActionButtonStyle}" automation:AutomationProperties.Name="Copy quota summary" IsTabStop="True" />
                <Border Style="{StaticResource PanelRule}" Margin="6,5" />
                <Button Tag="&#xE713;" ToolTip="Settings (Ctrl+,)" local:PanelMenuHints.Shortcut="Ctrl+," Content="Settings…" Click="OnSettings" Style="{StaticResource PanelActionButtonStyle}" automation:AutomationProperties.Name="Settings" IsTabStop="True" />
                <Button Tag="&#xE946;" Content="About AIBar" Click="OnAbout" Style="{StaticResource PanelActionButtonStyle}" automation:AutomationProperties.Name="About AIBar" />
                <Button Tag="&#xE7E8;" ToolTip="Quit (Ctrl+Q)" local:PanelMenuHints.Shortcut="Ctrl+Q" Content="Quit" Click="OnQuit" Style="{StaticResource PanelActionButtonStyle}" automation:AutomationProperties.Name="Quit AIBar" IsTabStop="True" />
            </StackPanel>
            <TextBlock x:Name="AboutText" Visibility="Collapsed" TextWrapping="Wrap" FontSize="12" Margin="0,6" automation:AutomationProperties.LiveSetting="Polite" />
            <TextBlock Text="{Binding CopySummaryCommand.Feedback}" Style="{StaticResource QuotaStatusTextStyle}" automation:AutomationProperties.LiveSetting="Polite" />
        </StackPanel>
    </Grid>
</Window>
