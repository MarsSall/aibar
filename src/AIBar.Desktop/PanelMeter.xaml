<UserControl x:Class="AIBar.Desktop.PanelMeter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AIBar.Desktop"
             xmlns:automation="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             Focusable="False" IsTabStop="False">
    <UserControl.Resources>
        <local:ProviderVisuals x:Key="Palette" />
        <local:PanelResetConverter x:Key="Reset" />
        <local:PanelWindowLabelConverter x:Key="WindowLabel" />
        <Style x:Key="PanelMeterProgressStyle" TargetType="ProgressBar" BasedOn="{StaticResource QuotaProgressStyle}">
            <Setter Property="Height" Value="6" />
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar">
                <Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3">
                    <Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" CornerRadius="3" HorizontalAlignment="Left" />
                </Border>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </UserControl.Resources>
    <Grid x:Name="MeterRoot" Tag="{DynamicResource SurfaceBrush}" Margin="0,12,0,0">
        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
        <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
        <TextBlock Grid.ColumnSpan="2" Text="{Binding Label, RelativeSource={RelativeSource AncestorType=local:PanelMeter}, Converter={StaticResource WindowLabel}}" FontSize="17" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" />
        <ProgressBar x:Name="MeterBar" Grid.Row="1" Grid.ColumnSpan="2" Margin="0,7,0,0" Style="{StaticResource PanelMeterProgressStyle}"
                     Value="{Binding Usage, RelativeSource={RelativeSource AncestorType=local:PanelMeter}}"
                     automation:AutomationProperties.Name="{Binding MeterName, RelativeSource={RelativeSource AncestorType=local:PanelMeter}}">
            <ProgressBar.Foreground><MultiBinding Converter="{StaticResource Palette}" ConverterParameter="Meter">
                <Binding Path="Usage" RelativeSource="{RelativeSource AncestorType=local:PanelMeter}" />
                <Binding Path="Tag" ElementName="MeterRoot" /><Binding Path="Tag.Color" ElementName="MeterRoot" />
                <Binding Path="IsCurrent" RelativeSource="{RelativeSource AncestorType=local:PanelMeter}" />
                <Binding Path="Provider" RelativeSource="{RelativeSource AncestorType=local:PanelMeter}" />
                <Binding Path="BarColorMode" RelativeSource="{RelativeSource AncestorType=local:MainWindow}" />
            </MultiBinding></ProgressBar.Foreground>
            <ProgressBar.Background><MultiBinding Converter="{StaticResource Palette}" ConverterParameter="Well">
                <Binding Source="0" /><Binding Path="Tag" ElementName="MeterRoot" /><Binding Path="Tag.Color" ElementName="MeterRoot" />
            </MultiBinding></ProgressBar.Background>
        </ProgressBar>
        <TextBlock x:Name="MeterPercent" Grid.Row="2" Margin="0,6,4,0" FontSize="13.5" Foreground="{DynamicResource TextBrush}"
                   Text="{Binding Usage, RelativeSource={RelativeSource AncestorType=local:PanelMeter}, StringFormat={}{0:0}% used, TargetNullValue=--}" />
        <TextBlock Grid.Row="2" Grid.Column="1" Margin="0,6,0,0" FontSize="13.5" Foreground="{DynamicResource MutedTextBrush}"><Run Text="Resets in " /><Run Text="{Binding ResetCountdown, RelativeSource={RelativeSource AncestorType=local:PanelMeter}, Converter={StaticResource Reset}, TargetNullValue=unavailable}" /></TextBlock>
        <local:PanelPaceRow Grid.Row="3" Grid.ColumnSpan="2" Data="{Binding Pace, RelativeSource={RelativeSource AncestorType=local:PanelMeter}}" />
    </Grid>
</UserControl>
