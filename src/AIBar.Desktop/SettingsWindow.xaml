<Window x:Class="AIBar.Desktop.SettingsWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
 Title="AIBar Settings" Width="600" Height="680" MinWidth="540" MinHeight="560"
 WindowStyle="None" WindowStartupLocation="CenterOwner" ResizeMode="CanResize"
 AllowsTransparency="True" Background="Transparent" Foreground="{DynamicResource SettingsTextBrush}"
 UseLayoutRounding="True" SnapsToDevicePixels="True"
 FontFamily="Segoe UI Variable Text, Segoe UI" FontSize="14" PreviewKeyDown="OnSettingsKeyDown">
 <shell:WindowChrome.WindowChrome><shell:WindowChrome CaptionHeight="32" ResizeBorderThickness="5" CornerRadius="8" GlassFrameThickness="0"/></shell:WindowChrome.WindowChrome>
 <Window.Resources><ResourceDictionary><ResourceDictionary.MergedDictionaries><ResourceDictionary Source="SettingsProviderMarks.xaml"/></ResourceDictionary.MergedDictionaries>
  <Style x:Key="SettingsFocus" TargetType="Control"><Setter Property="Template"><Setter.Value><ControlTemplate><Border BorderBrush="{DynamicResource SettingsFocusBrush}" BorderThickness="2" CornerRadius="6" Margin="-4"><Border BorderBrush="{DynamicResource SettingsSurfaceBrush}" BorderThickness="1" CornerRadius="4"/></Border></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="SettingsMeta" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="FontSize" Value="12"/><Setter Property="FontWeight" Value="Normal"/><Setter Property="Foreground" Value="{DynamicResource SettingsSecondaryBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=RadioButton}}" Value="True"><Setter Property="Foreground" Value="{DynamicResource SettingsHoverTextBrush}"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="SettingsHeading" TargetType="TextBlock" BasedOn="{StaticResource SettingsMeta}"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,8"/></Style>
  <Style x:Key="SettingsCard" TargetType="Border"><Setter Property="Background" Value="{DynamicResource SettingsCardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SettingsBorderBrush}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="6"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/><Setter Property="Background" Value="{DynamicResource SettingsCardBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource SettingsBorderBrush}"/><Setter Property="Padding" Value="12,4"/><Setter Property="Height" Value="32"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocus}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/></Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource SettingsIndicatorBrush}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsCaptionClose" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="Transparent"/><Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="{DynamicResource SettingsDangerBrush}"/><Setter Property="Foreground" Value="{DynamicResource SettingsOnAccentBrush}"/></Trigger></Style.Triggers></Style>
  <Style x:Key="SettingsToggle" TargetType="CheckBox">
   <EventSetter Event="Checked" Handler="OnToggleMotion"/><EventSetter Event="Unchecked" Handler="OnToggleMotion"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocus}"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal">
    <TextBlock x:Name="StateText" Text="Off" Foreground="{DynamicResource SettingsSecondaryBrush}" FontWeight="Normal" VerticalAlignment="Center" Margin="0,0,12,0"/>
    <Border x:Name="Track" Width="40" Height="20" CornerRadius="10" BorderThickness="1" BorderBrush="{DynamicResource SettingsSecondaryBrush}" Background="{DynamicResource SettingsCardBrush}">
     <Ellipse x:Name="Knob" Width="12" Height="12" Fill="{DynamicResource SettingsSecondaryBrush}" HorizontalAlignment="Left" Margin="3,0"><Ellipse.RenderTransform><TranslateTransform/></Ellipse.RenderTransform></Ellipse>
    </Border></StackPanel>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Track" Property="Background" Value="{DynamicResource SettingsAccentBrush}"/><Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource SettingsIndicatorBrush}"/><Setter TargetName="Knob" Property="Fill" Value="{DynamicResource SettingsOnAccentBrush}"/><Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right"/><Setter TargetName="StateText" Property="Text" Value="On"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Knob" Property="Width" Value="14"/><Setter TargetName="Knob" Property="Height" Value="14"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/>
   <Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocus}"/>
   <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
     <Border x:Name="SettingsCheckBox" Width="18" Height="18" CornerRadius="4" VerticalAlignment="Center" BorderThickness="1" BorderBrush="{DynamicResource SettingsControlBorderBrush}" Background="{DynamicResource SettingsControlBrush}">
      <Path x:Name="SettingsCheckGlyph" Data="M 3,8 L 6,11 L 12,4" Stroke="{DynamicResource SettingsOnAccentBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
     </Border>
     <ContentPresenter Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" RecognizesAccessKey="True"/>
    </Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="SettingsCheckBox" Property="Background" Value="{DynamicResource SettingsAccentBrush}"/><Setter TargetName="SettingsCheckBox" Property="BorderBrush" Value="{DynamicResource SettingsAccentBrush}"/><Setter TargetName="SettingsCheckGlyph" Property="Visibility" Value="Visible"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsRadio" TargetType="RadioButton">
   <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/><Setter Property="Background" Value="{DynamicResource SettingsCardBrush}"/>
   <Setter Property="Padding" Value="14,10"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocus}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton"><Border x:Name="Card" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="1" CornerRadius="6" Padding="{TemplateBinding Padding}">
    <DockPanel><Grid Width="18" Height="18" DockPanel.Dock="Left" VerticalAlignment="Top" Margin="0,1,8,0"><Ellipse Stroke="{DynamicResource SettingsSecondaryBrush}" StrokeThickness="1"/><Ellipse x:Name="Selected" Margin="4" Fill="{DynamicResource SettingsAccentBrush}" Visibility="Collapsed"/></Grid><ContentPresenter/></DockPanel>
   </Border><ControlTemplate.Triggers>
    <Trigger Property="IsChecked" Value="True"><Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource SettingsAccentBrush}"/><Setter TargetName="Card" Property="BorderThickness" Value="2"/><Setter TargetName="Card" Property="Padding" Value="13,9"/><Setter TargetName="Selected" Property="Visibility" Value="Visible"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Card" Property="Background" Value="{DynamicResource SettingsHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource SettingsHoverTextBrush}"/></Trigger>
   </ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="SettingsRefreshRadio" TargetType="RadioButton" BasedOn="{StaticResource SettingsRadio}">
   <Setter Property="HorizontalContentAlignment" Value="Center"/><Setter Property="MinHeight" Value="36"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
    <Border x:Name="Segment" Background="{DynamicResource SettingsCardBrush}" BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="1" CornerRadius="4" Margin="2,0" Padding="4,8"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="Segment" Property="Background" Value="{DynamicResource SettingsAccentBrush}"/><Setter TargetName="Segment" Property="BorderBrush" Value="{DynamicResource SettingsIndicatorBrush}"/><Setter Property="Foreground" Value="{DynamicResource SettingsOnAccentBrush}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
     <MultiTrigger><MultiTrigger.Conditions><Condition Property="IsChecked" Value="False"/><Condition Property="IsMouseOver" Value="True"/></MultiTrigger.Conditions><Setter TargetName="Segment" Property="Background" Value="{DynamicResource SettingsHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource SettingsHoverTextBrush}"/></MultiTrigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="RadioButton" BasedOn="{StaticResource SettingsRadio}"/>
  <Style TargetType="ComboBoxItem">
   <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/><Setter Property="Background" Value="{DynamicResource SettingsCardBrush}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem"><Border x:Name="Item" Background="{TemplateBinding Background}" Padding="8,6"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Item" Property="Background" Value="{DynamicResource SettingsHoverBrush}"/><Setter Property="Foreground" Value="{DynamicResource SettingsHoverTextBrush}"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter Property="FontWeight" Value="SemiBold"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/><Setter Property="Background" Value="{DynamicResource SettingsCardBrush}"/>
   <Setter Property="BorderBrush" Value="{DynamicResource SettingsControlBorderBrush}"/><Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocus}"/>
   <Setter Property="Width" Value="130"/><Setter Property="Height" Value="32"/><Setter Property="VerticalAlignment" Value="Center"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid>
    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
     <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="{DynamicResource SettingsCardBrush}" BorderBrush="{DynamicResource SettingsControlBorderBrush}" BorderThickness="1" CornerRadius="4"><TextBlock Text="▾" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,8,0" Foreground="{DynamicResource SettingsTextBrush}"/></Border></ControlTemplate></ToggleButton.Template>
    </ToggleButton>
    <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" Margin="8,0,24,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="{DynamicResource SettingsCardBrush}" BorderBrush="{DynamicResource SettingsControlBorderBrush}" BorderThickness="1" CornerRadius="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}"><ScrollViewer><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer></Border></Popup>
   </Grid><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TabItem"><Setter Property="Foreground" Value="{DynamicResource SettingsSecondaryBrush}"/><Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocus}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem"><Grid Height="40" Margin="12,0"><ContentPresenter ContentSource="Header" VerticalAlignment="Center"/><Border x:Name="Underline" Width="16" Height="3" CornerRadius="1" Background="{DynamicResource SettingsIndicatorBrush}" VerticalAlignment="Bottom" Visibility="Collapsed"/></Grid>
    <ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="Underline" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource SettingsTextBrush}"/><Setter Property="Background" Value="{DynamicResource SettingsCardBrush}"/><Setter Property="BorderBrush" Value="{DynamicResource SettingsBorderBrush}"/><Setter Property="Padding" Value="8,4"/><Setter Property="Height" Value="32"/><Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocus}"/></Style>
  <Style TargetType="Slider"><Setter Property="Foreground" Value="{DynamicResource SettingsAccentBrush}"/><Setter Property="FocusVisualStyle" Value="{StaticResource SettingsFocus}"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Height="24">
    <Track x:Name="PART_Track" Minimum="{TemplateBinding Minimum}" Maximum="{TemplateBinding Maximum}" Value="{Binding Value, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" IsDirectionReversed="{TemplateBinding IsDirectionReversed}">
     <Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border x:Name="SettingsSliderFill" Height="6" CornerRadius="3" Background="{DynamicResource SettingsAccentBrush}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
     <Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Height="6" CornerRadius="3" Background="{DynamicResource SettingsTrackBrush}"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
     <Track.Thumb><Thumb Width="18" Height="18"><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse x:Name="SettingsSliderThumb" Fill="{DynamicResource SettingsAccentBrush}" Stroke="{DynamicResource SettingsOnAccentBrush}" StrokeThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
    </Track>
   </Grid></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ProgressBar"><Setter Property="Focusable" Value="False"/><Setter Property="IsHitTestVisible" Value="False"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ProgressBar"><Border x:Name="PART_Track" Background="{TemplateBinding Background}" CornerRadius="3"><Border x:Name="PART_Indicator" Background="{TemplateBinding Foreground}" HorizontalAlignment="Left" CornerRadius="3"/></Border></ControlTemplate></Setter.Value></Setter></Style>
 <!-- Same slim scroll bar as the panel: rounded thumb, no arrow buttons. -->
<Style TargetType="ScrollBar">
 <Setter Property="Width" Value="6"/><Setter Property="MinWidth" Value="6"/><Setter Property="Margin" Value="4,2,0,2"/>
 <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar">
  <Track x:Name="PART_Track" IsDirectionReversed="True">
   <Track.DecreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageUpCommand}" Focusable="False" IsTabStop="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
   <Track.IncreaseRepeatButton><RepeatButton Command="{x:Static ScrollBar.PageDownCommand}" Focusable="False" IsTabStop="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
   <Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Border CornerRadius="3" Background="{DynamicResource MutedTextBrush}" Opacity="0.6"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb>
  </Track>
 </ControlTemplate></Setter.Value></Setter>
</Style>
</ResourceDictionary></Window.Resources>
 <!-- A transparent host reserves the spec's 40 DIP exterior shadow margin. -->
 <Border x:Name="SettingsShadow" Margin="40" CornerRadius="8" Background="{DynamicResource SettingsSurfaceBrush}">
 <Border x:Name="SettingsSurface" Background="{DynamicResource SettingsSurfaceBrush}" BorderBrush="{DynamicResource SettingsWindowBorderBrush}" BorderThickness="1" CornerRadius="8">
  <DockPanel>
   <Grid DockPanel.Dock="Top" Height="32" MouseLeftButtonDown="OnTitleDrag">
    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="46"/><ColumnDefinition Width="46"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0"><TextBlock Text="∞" Foreground="{DynamicResource SettingsCodexBrush}" Margin="0,0,10,0"/><TextBlock Text="AIBar Settings" FontSize="12"/></StackPanel>
    <Button Grid.Column="1" Content="−" AutomationProperties.Name="Minimize" Click="OnMinimize" shell:WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent" BorderBrush="Transparent"/>
    <Button Grid.Column="2" Content="□" AutomationProperties.Name="Maximize or restore" Click="OnMaximize" shell:WindowChrome.IsHitTestVisibleInChrome="True" Background="Transparent" BorderBrush="Transparent"/>
    <Button Grid.Column="3" Style="{StaticResource SettingsCaptionClose}" Content="×" AutomationProperties.Name="Close settings" Click="OnClose" shell:WindowChrome.IsHitTestVisibleInChrome="True"/>
   </Grid>
   <Border DockPanel.Dock="Bottom" CornerRadius="0,0,7,7" Height="56" Background="{DynamicResource SettingsFooterBrush}" BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="0,1,0,0" Padding="24,0">
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="96"/><ColumnDefinition Width="8"/><ColumnDefinition Width="96"/></Grid.ColumnDefinitions>
     <TextBlock x:Name="SaveStatus" Style="{StaticResource SettingsMeta}" Text="Changes apply when you save" VerticalAlignment="Center" AutomationProperties.LiveSetting="Polite" Margin="0,0,8,0"/>
     <Button Grid.Column="1" Content="Cancel" Click="OnClose" IsCancel="True"/>
     <Button x:Name="SaveButton" Grid.Column="3" Content="Save" Click="OnSave" IsDefault="True" FontWeight="SemiBold" Background="{DynamicResource SettingsAccentBrush}" Foreground="{DynamicResource SettingsOnAccentBrush}" AutomationProperties.Name="Save changes"/>
    </Grid>
   </Border>
   <TabControl x:Name="Sections" BorderThickness="0" Background="Transparent" Padding="0" HorizontalContentAlignment="Stretch">
    <TabControl.Template><ControlTemplate TargetType="TabControl"><DockPanel><Border DockPanel.Dock="Top" BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="0,0,0,1"><TabPanel IsItemsHost="True" Margin="16,0,0,0"/></Border><ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent"/></DockPanel></ControlTemplate></TabControl.Template>
    <TabItem Header="General" AutomationProperties.Name="General">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,16">
       <TextBlock Text="STARTUP" Style="{StaticResource SettingsHeading}"/>
       <Border Style="{StaticResource SettingsCard}" Padding="16,10">
        <CheckBox x:Name="StartWithWindows" Content="Start with Windows" AutomationProperties.Name="Start with Windows" Click="OnToggleStartup"/>
       </Border>
       <TextBlock Text="UPDATES" Style="{StaticResource SettingsHeading}" Margin="0,16,0,8"/>
        <Border Style="{StaticResource SettingsCard}" Padding="16,10"><StackPanel>
         <CheckBox x:Name="CheckForUpdates" Content="Check for new versions" AutomationProperties.Name="Check for new versions" IsChecked="True"/>
         <TextBlock Text="Anonymous GitHub check. Opens the release page only; never downloads or installs updates." Style="{StaticResource SettingsMeta}" TextWrapping="Wrap" Margin="0,8,0,0"/>
        </StackPanel></Border>
        <TextBlock Text="LOCAL DATA" Style="{StaticResource SettingsHeading}" Margin="0,16,0,8"/>
       <Border Style="{StaticResource SettingsCard}" Padding="16,10"><StackPanel>
        <Button x:Name="ClearData" Content="Clear AIBar Data" AutomationProperties.Name="Clear AIBar Data" Click="OnClearData" HorizontalAlignment="Left"/>
        <TextBlock x:Name="GeneralStatus" Style="{StaticResource SettingsMeta}" Margin="0,8,0,0" AutomationProperties.LiveSetting="Polite"/>
       </StackPanel></Border>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="Appearance" AutomationProperties.Name="Appearance">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,16">
       <TextBlock Text="THEME" Style="{StaticResource SettingsHeading}"/>
       <Border Style="{StaticResource SettingsCard}" Padding="16,6" Margin="0,0,0,8"><StackPanel><TextBlock Text="◐   Follows Windows"/><TextBlock x:Name="ThemeDescription" Style="{StaticResource SettingsMeta}" Margin="30,2,0,0" Text="Change it in Windows Settings › Personalization › Colors."/></StackPanel></Border>
       <Border Style="{StaticResource SettingsCard}" Padding="16,6" Margin="0,0,0,16">
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="120"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions>
         <StackPanel><TextBlock Text="Background opacity"/><TextBlock Text="Panel and notifications. Text and bars stay solid." Style="{StaticResource SettingsMeta}" Margin="0,2,10,0"/></StackPanel>
         <Slider x:Name="BackgroundOpacity" Grid.Column="1" Minimum="30" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="100" SmallChange="5" LargeChange="10" VerticalAlignment="Center" AutomationProperties.Name="Background opacity" AutomationProperties.HelpText="30 to 100 percent in steps of 5. High contrast and disabled transparency use 100 percent."/>
         <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=BackgroundOpacity, StringFormat={}{0:0} %}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
        </Grid>
       </Border>
       <Border Style="{StaticResource SettingsCard}" Padding="16,10" Margin="0,-8,0,16">
        <CheckBox x:Name="ProviderTint" IsChecked="True" AutomationProperties.Name="Provider tint" AutomationProperties.HelpText="Colors the panel border, glow, header divider and selected tab with the selected provider.">
         <StackPanel><TextBlock Text="Provider tint"/><TextBlock Text="Border, glow and selected tab follow the provider color." Style="{StaticResource SettingsMeta}" Margin="0,2,0,0"/></StackPanel>
        </CheckBox>
       </Border>
       <Border Style="{StaticResource SettingsCard}" Padding="16,10" Margin="0,-8,0,16">
        <CheckBox x:Name="FloatingWidget" AutomationProperties.Name="Floating widget" AutomationProperties.HelpText="Show an always-on-top strip with quota rings. Drag it to any screen edge.">
         <StackPanel><TextBlock Text="Floating widget"/><TextBlock Text="Show an always-on-top strip with quota rings. Drag it to any screen edge." Style="{StaticResource SettingsMeta}" Margin="0,2,0,0"/></StackPanel>
        </CheckBox>
       </Border>
       <TextBlock Text="PANEL BARS" Style="{StaticResource SettingsHeading}"/>
       <Grid Margin="0,0,0,16" KeyboardNavigation.DirectionalNavigation="Contained"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <RadioButton x:Name="BarBrand" GroupName="PanelBars" IsChecked="True" AutomationProperties.Name="Panel bar colors: Brand colors" MinHeight="116">
         <StackPanel><TextBlock Text="Brand colors"/><Grid Margin="-24,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <TextBlock Text="Codex" Style="{StaticResource SettingsMeta}"/><ProgressBar Grid.Column="1" Value="40" Height="6" Foreground="{DynamicResource SettingsCodexBrush}" Background="{DynamicResource SettingsTrackBrush}"/>
          <TextBlock Grid.Row="1" Text="Claude" Style="{StaticResource SettingsMeta}" Margin="0,6,0,0"/><ProgressBar Grid.Row="1" Grid.Column="1" Value="82" Height="6" Margin="0,6,0,0" Foreground="{DynamicResource SettingsClaudeBrush}" Background="{DynamicResource SettingsTrackBrush}"/>
         </Grid></StackPanel>
        </RadioButton>
        <RadioButton x:Name="BarUsage" Grid.Column="2" GroupName="PanelBars" AutomationProperties.Name="Panel bar colors: Usage level" MinHeight="116">
         <StackPanel><TextBlock Text="Usage level"/><Grid Margin="-24,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition/><RowDefinition/><RowDefinition/></Grid.RowDefinitions>
          <TextBlock Text="40%" Style="{StaticResource SettingsMeta}"/><ProgressBar Grid.Column="1" Value="40" Height="6" Foreground="{DynamicResource SettingsUsageOkBrush}" Background="{DynamicResource SettingsTrackBrush}"/>
          <TextBlock Grid.Row="1" Text="80%" Style="{StaticResource SettingsMeta}" Margin="0,6,0,0"/><ProgressBar Grid.Row="1" Grid.Column="1" Value="80" Height="6" Margin="0,6,0,0" Foreground="{DynamicResource SettingsUsageWarnBrush}" Background="{DynamicResource SettingsTrackBrush}"/>
          <TextBlock Grid.Row="2" Text="95%" Style="{StaticResource SettingsMeta}" Margin="0,6,0,0"/><ProgressBar Grid.Row="2" Grid.Column="1" Value="95" Height="6" Margin="0,6,0,0" Foreground="{DynamicResource SettingsUsageHighBrush}" Background="{DynamicResource SettingsTrackBrush}"/>
         </Grid></StackPanel>
        </RadioButton>
       </Grid>
       <TextBlock Text="YASB STATUS-BAR WIDGET" Style="{StaticResource SettingsHeading}"/>
       <Border Style="{StaticResource SettingsCard}" Padding="16,10" Margin="0,0,0,8"><StackPanel>
        <Button x:Name="InstallYasbFont" Content="Install YASB font" AutomationProperties.Name="Install YASB font" Click="OnInstallYasbFont" HorizontalAlignment="Left"/>
        <TextBlock x:Name="FontStatus" Style="{StaticResource SettingsMeta}" Margin="0,4,0,0" AutomationProperties.LiveSetting="Polite"/>
       </StackPanel></Border>
       <Grid KeyboardNavigation.DirectionalNavigation="Contained"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <RadioButton x:Name="YasbUsage" GroupName="Yasb" IsChecked="True" AutomationProperties.Name="YASB colors: Usage level" MinHeight="84"><StackPanel><TextBlock Text="Usage level"/><Border Background="{DynamicResource SettingsFooterBrush}" CornerRadius="4" Padding="6" Margin="-24,10,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="14% ▰" Foreground="{DynamicResource SettingsUsageOkBrush}" FontSize="11"/><TextBlock Text="   92% ▰" Foreground="{DynamicResource SettingsUsageHighBrush}" FontSize="11"/></StackPanel></Border></StackPanel></RadioButton>
        <RadioButton x:Name="YasbBrand" Grid.Column="2" GroupName="Yasb" AutomationProperties.Name="YASB colors: Brand colors" MinHeight="84"><StackPanel><TextBlock Text="Brand colors"/><Border Background="{DynamicResource SettingsFooterBrush}" CornerRadius="4" Padding="6" Margin="-24,10,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="14% ▰" Foreground="{DynamicResource SettingsCodexBrush}" FontSize="11"/><TextBlock Text="   92% ▰" Foreground="{DynamicResource SettingsClaudeBrush}" FontSize="11"/></StackPanel></Border></StackPanel></RadioButton>
       </Grid>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem AutomationProperties.Name="Alerts">
     <TabItem.Header><StackPanel Orientation="Horizontal"><TextBlock Text="Alerts"/><TextBlock x:Name="AlertsErrorDot" Text="●" FontSize="9" Foreground="{DynamicResource SettingsDangerBrush}" Margin="5,0,0,0" Visibility="Collapsed" AutomationProperties.Name="Alerts has an error"/></StackPanel></TabItem.Header>
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,16">
       <TextBlock Text="NOTIFY ME WHEN" Style="{StaticResource SettingsHeading}"/>
       <Border Style="{StaticResource SettingsCard}"><StackPanel>
        <Grid MinHeight="36" Margin="16,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Window resets"/><TextBlock Text="A session or weekly window starts over" Style="{StaticResource SettingsMeta}"/></StackPanel><CheckBox x:Name="Resets" Grid.Column="1" Style="{StaticResource SettingsToggle}" IsChecked="True" AutomationProperties.Name="Window resets"/></Grid>
        <Border BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="0,1,0,1" Padding="16,6"><StackPanel>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Thresholds"/><TextBlock Text="Usage crosses one of the values below" Style="{StaticResource SettingsMeta}"/></StackPanel><CheckBox x:Name="Thresholds" Grid.Column="1" Style="{StaticResource SettingsToggle}" IsChecked="True" AutomationProperties.Name="Crossed thresholds"/></Grid>
         <Label Content="Thresholds (%)" Target="{Binding ElementName=ThresholdInput}" FontSize="12" Foreground="{DynamicResource SettingsSecondaryBrush}" Padding="0" Margin="0,6,0,4"/>
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="168"/><ColumnDefinition Width="16"/><ColumnDefinition/></Grid.ColumnDefinitions>
          <TextBox x:Name="ThresholdInput" Text="75, 90, 100" TextChanged="OnThresholdChanged" AutomationProperties.Name="Alert thresholds (%)" AutomationProperties.HelpText="Comma-separated ascending integers from 1 to 100. Default: 75, 90, 100."/>
          <Grid x:Name="ThresholdTicks" Grid.Column="2" VerticalAlignment="Center"><Border Height="6" CornerRadius="3" Background="{DynamicResource SettingsTrackBrush}"/><Canvas x:Name="TickCanvas" Height="32" SizeChanged="OnTickSizeChanged" IsHitTestVisible="False"/></Grid>
         </Grid>
         <TextBlock x:Name="ThresholdError" Style="{StaticResource SettingsMeta}" Text="1–100, ascending" Margin="0,5,0,6" AutomationProperties.LiveSetting="Assertive"/>
        </StackPanel></Border>
        <Grid MinHeight="36" Margin="16,6"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="Runs out before reset"/><TextBlock Text="At the current pace a window hits 100% early" Style="{StaticResource SettingsMeta}"/></StackPanel><CheckBox x:Name="RunOut" Grid.Column="1" Style="{StaticResource SettingsToggle}" IsChecked="True" AutomationProperties.Name="May run out before reset"/></Grid>
       </StackPanel></Border>
       <TextBlock Text="EFFECTS" Style="{StaticResource SettingsHeading}" Margin="0,16,0,8"/>
       <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
        <Border Style="{StaticResource SettingsCard}" Padding="8"><StackPanel>
         <Button Click="OnPreviewNotification" Height="56" Padding="4" AutomationProperties.Name="Preview Windows notification"><Border Background="{DynamicResource SettingsFooterBrush}" Padding="4"><StackPanel><TextBlock Text="▶" FontSize="12"/><Border Background="{DynamicResource SettingsCardBrush}" Padding="5" CornerRadius="3"><TextBlock Text="AIBar · Window reset" FontSize="9"/></Border></StackPanel></Border></Button>
         <CheckBox x:Name="Notification" IsChecked="True" Margin="0,8,0,0" AutomationProperties.Name="Windows notification"><TextBlock Text="Windows notification" FontSize="13" FontWeight="SemiBold"/></CheckBox>
        </StackPanel></Border>
        <Border Grid.Column="2" Style="{StaticResource SettingsCard}" Padding="8"><StackPanel>
         <Button Click="OnPreviewGlow" Height="56" Padding="0" AutomationProperties.Name="Preview edge glow"><Border BorderBrush="{DynamicResource SettingsClaudeBrush}" BorderThickness="6" Width="112" Height="54"><TextBlock Text="▶" VerticalAlignment="Center" HorizontalAlignment="Center"/></Border></Button>
         <CheckBox x:Name="EdgeGlow" IsChecked="True" Margin="0,8,0,0" AutomationProperties.Name="Edge glow at limit"><TextBlock Text="Edge glow at limit" FontSize="13" FontWeight="SemiBold"/></CheckBox>
        </StackPanel></Border>
        <Border Grid.Column="4" Style="{StaticResource SettingsCard}" Padding="8"><StackPanel>
         <Button Click="OnPreviewConfetti" Height="56" Padding="4" AutomationProperties.Name="Preview confetti"><StackPanel><TextBlock Text="▪  ◆  •  ▪" Foreground="{DynamicResource SettingsCodexBrush}"/><TextBlock Text="▶  •  ▰  ◆" Foreground="{DynamicResource SettingsUsageWarnBrush}"/></StackPanel></Button>
         <CheckBox x:Name="Confetti" IsChecked="False" Margin="0,8,0,0" AutomationProperties.Name="Confetti on reset"><TextBlock Text="Confetti on reset" FontSize="13" FontWeight="SemiBold"/></CheckBox>
        </StackPanel></Border>
       </Grid>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
    <TabItem Header="Providers" AutomationProperties.Name="Providers">
     <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="24,16">
       <TextBlock Text="SHOW IN AIBAR" Style="{StaticResource SettingsHeading}"/>
       <Border Style="{StaticResource SettingsCard}"><StackPanel>
        <Grid MinHeight="44" Margin="12,6"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Border Background="{DynamicResource SettingsFooterBrush}" Width="28" Height="28" CornerRadius="6"><Path x:Name="CodexMark" Data="{StaticResource SettingsOpenAiMark}" Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource SettingsCodexBrush}"/></Border>
         <CheckBox x:Name="CodexEnabled" Grid.Column="1" Content="Show Codex in AIBar" VerticalAlignment="Center" AutomationProperties.Name="Show Codex in AIBar"/>
         <Label Grid.Column="2" Content="Source" Target="{Binding ElementName=CodexSource}" Foreground="{DynamicResource SettingsSecondaryBrush}" VerticalAlignment="Center" Padding="4,0,6,0"/>
         <ComboBox x:Name="CodexSource" Grid.Column="3" SelectedIndex="0" AutomationProperties.Name="Codex source">
          <ComboBoxItem Content="Automatic" ToolTip="Uses data sent from another machine when it exists, otherwise this PC's login."/>
          <ComboBoxItem Content="This PC" ToolTip="Only this PC's login."/>
          <ComboBoxItem Content="Other machine" ToolTip="Only data sent from another machine."/>
         </ComboBox>
        </Grid>
        <Border BorderBrush="{DynamicResource SettingsBorderBrush}" BorderThickness="0,1,0,0"/>
        <Grid MinHeight="44" Margin="12,6"><Grid.ColumnDefinitions><ColumnDefinition Width="36"/><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
         <Border Background="{DynamicResource SettingsFooterBrush}" Width="28" Height="28" CornerRadius="6"><Path x:Name="ClaudeMark" Data="{StaticResource SettingsClaudeMark}" Width="20" Height="20" Stretch="Uniform" Fill="{DynamicResource SettingsClaudeBrush}"/></Border>
         <CheckBox x:Name="ClaudeEnabled" Grid.Column="1" Content="Show Claude in AIBar" VerticalAlignment="Center" AutomationProperties.Name="Show Claude in AIBar"/>
         <Label Grid.Column="2" Content="Source" Target="{Binding ElementName=ClaudeSource}" Foreground="{DynamicResource SettingsSecondaryBrush}" VerticalAlignment="Center" Padding="4,0,6,0"/>
         <ComboBox x:Name="ClaudeSource" Grid.Column="3" SelectedIndex="0" AutomationProperties.Name="Claude source">
          <ComboBoxItem Content="Automatic" ToolTip="Uses data sent from another machine when it exists, otherwise this PC's login."/>
          <ComboBoxItem Content="This PC" ToolTip="Only this PC's login."/>
          <ComboBoxItem Content="Other machine" ToolTip="Only data sent from another machine."/>
         </ComboBox>
        </Grid>
       </StackPanel></Border>
       <TextBlock x:Name="SourceStatus" Style="{StaticResource SettingsMeta}" Margin="2,10,0,0" AutomationProperties.LiveSetting="Polite"/>
       <TextBlock Text="REFRESH EVERY" Style="{StaticResource SettingsHeading}" Margin="0,16,0,8"/>
       <UniformGrid x:Name="RefreshChoices" Rows="1" KeyboardNavigation.TabNavigation="Once" KeyboardNavigation.DirectionalNavigation="Contained" PreviewKeyDown="OnRefreshKeyDown" AutomationProperties.Name="Refresh every">
        <RadioButton x:Name="Refresh1" Style="{StaticResource SettingsRefreshRadio}" GroupName="RefreshInterval" Content="1 min" Tag="1" IsTabStop="False" Checked="OnRefreshSelected" AutomationProperties.Name="Refresh every 1 min"/>
        <RadioButton x:Name="Refresh2" Style="{StaticResource SettingsRefreshRadio}" GroupName="RefreshInterval" Content="2 min" Tag="2" IsTabStop="False" Checked="OnRefreshSelected" AutomationProperties.Name="Refresh every 2 min"/>
        <RadioButton x:Name="Refresh5" Style="{StaticResource SettingsRefreshRadio}" GroupName="RefreshInterval" Content="5 min" Tag="5" IsChecked="True" Checked="OnRefreshSelected" AutomationProperties.Name="Refresh every 5 min"/>
        <RadioButton x:Name="Refresh15" Style="{StaticResource SettingsRefreshRadio}" GroupName="RefreshInterval" Content="15 min" Tag="15" IsTabStop="False" Checked="OnRefreshSelected" AutomationProperties.Name="Refresh every 15 min"/>
        <RadioButton x:Name="Refresh30" Style="{StaticResource SettingsRefreshRadio}" GroupName="RefreshInterval" Content="30 min" Tag="30" IsTabStop="False" Checked="OnRefreshSelected" AutomationProperties.Name="Refresh every 30 min"/>
       </UniformGrid>
       <TextBlock x:Name="RefreshRateLimitNote" Text="May hit provider rate limits." Style="{StaticResource SettingsMeta}" Margin="2,8,0,0" Visibility="Collapsed" AutomationProperties.LiveSetting="Polite"/>
      </StackPanel>
     </ScrollViewer>
    </TabItem>
   </TabControl>
  </DockPanel>
 </Border>
 </Border>
</Window>
