<Window x:Class="AIBar.Desktop.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AIBar Settings" Width="590" Height="660" MinWidth="460" MinHeight="480"
        WindowStartupLocation="CenterOwner" Background="{DynamicResource SurfaceBrush}"
        Foreground="{DynamicResource TextBrush}" FontFamily="Segoe UI" FontSize="14">
    <Window.Resources>
        <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
        <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,7"/></Style>
        <Style TargetType="GroupBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Margin" Value="0,10"/><Setter Property="Padding" Value="16"/></Style>
        <Style TargetType="ComboBox">
            <Setter Property="Margin" Value="0,6,0,16"/><Setter Property="MinHeight" Value="32"/>
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SecondaryBorderBrush}" BorderThickness="1" CornerRadius="4" Padding="10,6">
                                <DockPanel><TextBlock DockPanel.Dock="Right" Text="⌄" Margin="12,0,0,0"/><ContentPresenter/></DockPanel>
                            </Border>
                        </ControlTemplate></ToggleButton.Template>
                        <ContentPresenter Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" HorizontalAlignment="Left"/>
                    </ToggleButton>
                    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False">
                        <Border Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SecondaryBorderBrush}" BorderThickness="1" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                            <ScrollViewer MaxHeight="240" CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                        </Border>
                    </Popup>
                    <Border x:Name="FocusRing" BorderBrush="{DynamicResource FocusBrush}" BorderThickness="2" CornerRadius="4" IsHitTestVisible="False" Visibility="Collapsed"/>
                </Grid>
                <ControlTemplate.Triggers><Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="FocusRing" Property="Visibility" Value="Visible"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="ItemBorder" Padding="10,8" Background="{TemplateBinding Background}" BorderThickness="2" BorderBrush="Transparent"><ContentPresenter/></Border>
                <ControlTemplate.Triggers><Trigger Property="IsHighlighted" Value="True"><Setter TargetName="ItemBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Trigger></ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/><Setter Property="Padding" Value="7"/></Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="18,7"/><Setter Property="Margin" Value="8,0,0,0"/><Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border x:Name="ButtonBorder" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource SecondaryBorderBrush}" BorderThickness="2" CornerRadius="4" Padding="{TemplateBinding Padding}"><ContentPresenter RecognizesAccessKey="True" HorizontalAlignment="Center"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource MutedTextBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TabItem">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/><Setter Property="Padding" Value="18,9"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TabItem">
                <Border x:Name="TabBorder" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SecondaryBorderBrush}" BorderThickness="0,0,0,2" Padding="{TemplateBinding Padding}"><ContentPresenter ContentSource="Header" RecognizesAccessKey="True"/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="TabBorder" Property="BorderThickness" Value="2"/><Setter TargetName="TabBorder" Property="BorderBrush" Value="{DynamicResource FocusBrush}"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
    </Window.Resources>
    <DockPanel Margin="24">
        <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
            <TextBlock Text="Settings" FontSize="26" FontWeight="SemiBold"/>
            <TextBlock Text="Make AIBar yours. Appearance follows your Windows theme." Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0"/>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
            <TextBlock x:Name="SaveStatus" AutomationProperties.LiveSetting="Polite" Margin="0,0,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="_Close" Click="OnClose" IsCancel="True"/>
                <Button x:Name="SaveButton" Content="_Save changes" Click="OnSave" IsDefault="True" AutomationProperties.Name="Save changes"/>
            </StackPanel>
        </StackPanel>
        <TabControl x:Name="Sections" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource SecondaryBorderBrush}" Foreground="{DynamicResource TextBrush}">
            <TabItem Header="Colors">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16">
                        <TextBlock Text="Colors" FontSize="20" FontWeight="SemiBold"/>
                        <GroupBox Header="Panel">
                            <StackPanel>
                                <Label Content="Panel _bars" Target="{Binding ElementName=BarColors}" Foreground="{DynamicResource TextBrush}"/>
                                <ComboBox x:Name="BarColors" SelectedIndex="0" AutomationProperties.Name="Panel bar colors">
                                    <ComboBoxItem Content="Brand colors"/><ComboBoxItem Content="Usage level"/>
                                </ComboBox>
                                <TextBlock Text="Usage level: green below 75%, yellow from 75%, red from 90%." Foreground="{DynamicResource MutedTextBrush}"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="YASB">
                            <StackPanel>
                                <Label Content="_YASB colors" Target="{Binding ElementName=YasbColors}" Foreground="{DynamicResource TextBrush}"/>
                                <ComboBox x:Name="YasbColors" SelectedIndex="0" AutomationProperties.Name="YASB colors">
                                    <ComboBoxItem Content="Usage level"/><ComboBoxItem Content="Brand colors"/>
                                </ComboBox>
                                <TextBlock Text="Brand colors: Codex green, Claude terracotta. YASB applies changes on its next refresh." Foreground="{DynamicResource MutedTextBrush}"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Alerts">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="16">
                        <TextBlock Text="Alerts" FontSize="20" FontWeight="SemiBold"/>
                        <GroupBox Header="When to alert">
                            <StackPanel>
                                <CheckBox x:Name="Resets" Content="Window _resets" IsChecked="True"/>
                                <CheckBox x:Name="Thresholds" Content="Crossed _thresholds" IsChecked="True"/>
                                <Label Content="Thresholds (%) — _ascending integers, 1–100" Target="{Binding ElementName=ThresholdInput}" Foreground="{DynamicResource TextBrush}"/>
                                <TextBox x:Name="ThresholdInput" Text="75, 90, 100" TextChanged="OnThresholdChanged" AutomationProperties.Name="Alert thresholds (%)" AutomationProperties.HelpText="Comma-separated ascending integers from 1 to 100. Default: 75, 90, 100."/>
                                <TextBlock x:Name="ThresholdError" AutomationProperties.LiveSetting="Assertive" Margin="0,6"/>
                                <CheckBox x:Name="RunOut" Content="May run out _before reset" IsChecked="True"/>
                            </StackPanel>
                        </GroupBox>
                        <GroupBox Header="Effects">
                            <StackPanel>
                                <CheckBox x:Name="Notification" Content="_Windows notification" IsChecked="True"/>
                                <CheckBox x:Name="EdgeGlow" Content="Edge _glow at limit (100%)" IsChecked="True"/>
                                <CheckBox x:Name="Confetti" Content="_Confetti on window reset" IsChecked="False"/>
                                <TextBlock Text="Glow and confetti never take focus or intercept clicks. High contrast disables both. Reduced motion disables confetti and makes glow static." Foreground="{DynamicResource MutedTextBrush}"/>
                            </StackPanel>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
