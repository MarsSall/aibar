<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="NotificationDismissStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource NotificationSecondaryTextBrush}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border x:Name="FocusRing" Margin="-3" BorderThickness="2" CornerRadius="6" BorderBrush="Transparent" />
                        <Border x:Name="InnerRing" Margin="-1" BorderThickness="1" CornerRadius="4" BorderBrush="Transparent" />
                        <Border x:Name="Fill" CornerRadius="4" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Fill" Property="Background" Value="{DynamicResource NotificationHoverBrush}" /><Setter Property="Foreground" Value="{DynamicResource NotificationHoverTextBrush}" /></Trigger>
                        <Trigger Property="IsPressed" Value="True"><Setter TargetName="Fill" Property="Opacity" Value="0.8" /></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="FocusRing" Property="BorderBrush" Value="{DynamicResource NotificationFocusBrush}" />
                            <Setter TargetName="InnerRing" Property="BorderBrush" Value="{DynamicResource NotificationSurfaceBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
