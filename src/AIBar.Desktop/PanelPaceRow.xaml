<UserControl x:Class="AIBar.Desktop.PanelPaceRow" x:Name="Row"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:AIBar.Desktop"
             Focusable="False" IsTabStop="False"
             Visibility="{Binding Data.IsVisible, ElementName=Row, Converter={StaticResource BooleanToVisibilityConverter}, FallbackValue=Collapsed}"
             AutomationProperties.Name="{Binding Data.AutomationName, ElementName=Row}"
             AutomationProperties.HelpText="{Binding Data.HelpText, ElementName=Row}" AutomationProperties.LiveSetting="Polite">
    <UserControl.Resources><local:ProviderVisuals x:Key="Palette" /></UserControl.Resources>
    <Grid DataContext="{Binding Data, ElementName=Row}" Tag="{DynamicResource SurfaceBrush}" x:Name="PaceRoot" Margin="0,6,0,0">
        <TextBlock Text="{Binding Text}" FontSize="12" TextWrapping="Wrap">
            <TextBlock.Foreground><MultiBinding Converter="{StaticResource Palette}" ConverterParameter="PaceText">
                <Binding Path="Tone" /><Binding Path="Tag" ElementName="PaceRoot" /><Binding Path="Tag.Color" ElementName="PaceRoot" />
            </MultiBinding></TextBlock.Foreground>
        </TextBlock>
    </Grid>
</UserControl>
